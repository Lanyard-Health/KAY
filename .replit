modules = ["nodejs-20", "web", "bash", "postgresql-16"]

[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[userenv]

[userenv.shared]
DEV_AUTH_BYPASS = "true"
FRONTEND_URL = "http://localhost:5000"
NODE_ENV = "development"
PORT = "3002"
VITE_DEV_AUTH_BYPASS = "true"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Backend"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Backend"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd packages/shared && npx tsc --noEmit 2>/dev/null; npx tsc; cd ../.. && env -u REDIS_URL -u REDIS_HOST -u REDIS_PORT -u REDIS_PASSWORD npm run dev --workspace=packages/backend"
waitForPort = 3002

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "env -u VITE_API_URL npm run dev --workspace=packages/frontend"
waitForPort = 5000

[[ports]]
localPort = 3002
externalPort = 80

[[ports]]
localPort = 5000
externalPort = 5000

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 300000
