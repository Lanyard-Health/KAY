# Database
DATABASE_URL=postgresql://credentials:credentials_dev_password@localhost:5433/credentials

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# AWS Cognito
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_DOMAIN=

# AWS S3
S3_BUCKET_NAME=
S3_DOCUMENTS_PREFIX=documents/

# AWS Textract
TEXTRACT_SNS_TOPIC_ARN=
TEXTRACT_SNS_ROLE_ARN=

# CAQH API
CAQH_ORG_ID=
CAQH_API_KEY=
CAQH_API_URL=https://proview-demo.caqh.org/api

# Application
NODE_ENV=development
PORT=3002
FRONTEND_URL=http://localhost:5190
JWT_SECRET=your-jwt-secret-here

# Email (SES)
SES_FROM_EMAIL=noreply@yourdomain.com
