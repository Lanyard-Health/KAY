# Database
DATABASE_URL=postgresql://credentials:credentials_dev_password@localhost:5433/credentials

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# AWS Cognito
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_DOMAIN=

# AWS S3 / Cloudflare R2
S3_ENDPOINT=http://localhost:4566
S3_BUCKET_NAME=credentials-documents
S3_DOCUMENTS_PREFIX=documents/

# LocalStack (local dev only — do NOT set in production)
USE_LOCALSTACK=true

# AWS Textract
TEXTRACT_SNS_TOPIC_ARN=
TEXTRACT_SNS_ROLE_ARN=

# CAQH API
CAQH_ORG_ID=
CAQH_API_KEY=
CAQH_API_URL=https://proview-demo.caqh.org/api

# Application
NODE_ENV=development
# IMPORTANT: This port must match the proxy target in packages/frontend/vite.config.ts
# (currently proxying /api -> http://localhost:3002)
PORT=3002
FRONTEND_URL=http://localhost:5190
JWT_SECRET=your-jwt-secret-here

# AI features
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-4-20250514
AI_DAILY_TOKEN_BUDGET=100000

# Email (AWS SES)
SES_FROM_EMAIL=noreply@lanyardhealth.com
AWS_SES_REGION=us-east-1

# Aetna FHIR Provider Directory
AETNA_CLIENT_ID=
AETNA_CLIENT_SECRET=
AETNA_FHIR_BASE_URL=https://vteapif1.aetna.com/fhirdemo/v1/patientaccess
AETNA_TOKEN_URL=
DIRECTORY_CHECK_SCHEDULE=0 3 * * 0
