# ============================================================================
# Lanyard Health — Backend Environment Variables
# Copy to .env and fill in values. See CLAUDE.md for details.
# ============================================================================

# --- Core ---

# Node environment (development | production | test)
NODE_ENV=development

# Server port — must match the proxy target in packages/frontend/vite.config.ts
# Required
PORT=3002

# Frontend URL for CORS origin and redirect links
# Required
FRONTEND_URL=http://localhost:5190

# Alternative URL used in portal/practice signup email links (falls back to FRONTEND_URL)
# Optional
APP_URL=http://localhost:5190

# Log level for winston logger (error | warn | info | debug)
# Optional — defaults to "info"
LOG_LEVEL=info

# AES-256-GCM encryption key for PII fields (SSN, tax IDs, banking data)
# Must be a 64-character hex string (32 bytes). Required in production.
ENCRYPTION_KEY=your-64-char-hex-encryption-key-here-0000000000000000000000

# --- Auth ---

# Legacy JWT secret — kept for backwards compatibility, auth uses Cognito JWTs
# Optional
JWT_SECRET=your-jwt-secret-here

# AWS Cognito user pool settings — required in production, optional with DEV_AUTH_BYPASS
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
# Cognito domain for hosted UI (optional)
COGNITO_DOMAIN=

# Separate AWS credentials for Cognito (falls back to main AWS_ACCESS_KEY_ID/SECRET)
# Optional — use when Cognito is in a different AWS account than S3
COGNITO_AWS_ACCESS_KEY_ID=
COGNITO_AWS_SECRET_ACCESS_KEY=
COGNITO_AWS_REGION=us-east-1

# Enable dev auth bypass — skips Cognito token verification, auto-creates dev user
# Set to "true" for local development only. CRASHES the server if set in production.
# Optional — defaults to disabled
DEV_AUTH_BYPASS=true

# --- Database ---

# PostgreSQL connection string — required
DATABASE_URL=postgresql://credentials:credentials_dev_password@localhost:5433/credentials

# --- Redis ---

# Redis connection URL (takes precedence over REDIS_HOST/PORT/PASSWORD)
# Optional — Redis features degrade gracefully if not configured
REDIS_URL=

# Individual Redis connection settings (used if REDIS_URL is not set)
# Optional
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- AWS / Storage ---

# AWS region for S3, SES, Textract, and Cognito (when not overridden)
# Optional — defaults to "us-east-1"
AWS_REGION=us-east-1

# AWS credentials for S3, SES, and Textract
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# S3-compatible storage endpoint (LocalStack for dev, Cloudflare R2 for prod)
# Optional — uses AWS S3 default if not set
S3_ENDPOINT=http://localhost:4566

# S3 bucket name for document uploads
# Optional — defaults to "credentials-documents"
S3_BUCKET_NAME=credentials-documents

# S3 key prefix for uploaded documents
# Optional — defaults to "documents/"
S3_DOCUMENTS_PREFIX=documents/

# Use LocalStack for local S3 development (do NOT set in production)
# Optional — defaults to disabled
USE_LOCALSTACK=true

# AWS Textract for document OCR — SNS notification config
# Optional — async Textract disabled if not set
TEXTRACT_SNS_TOPIC_ARN=
TEXTRACT_SNS_ROLE_ARN=

# --- Email ---

# Resend API key — email features disabled if not set
# Optional
RESEND_API_KEY=

# Sender email address for Resend — email features disabled if not set
# Optional (SES_FROM_EMAIL is accepted as deprecated fallback)
RESEND_FROM_EMAIL=noreply@lanyardhealth.com

# Admin email for notifications (application approvals, sync alerts)
# Optional — admin notifications disabled if not set
ADMIN_EMAIL=

# Gmail API credentials — alternative email transport (optional)
# Feature degrades gracefully if not configured
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=

# --- Integrations: Anthropic AI ---

# Anthropic API key for AI chat, denial triage, payer intelligence, and bug triage
# Optional — AI features disabled if not set
ANTHROPIC_API_KEY=

# Claude model ID for AI features
# Optional — defaults to "claude-sonnet-4-20250514"
AI_MODEL=claude-sonnet-4-20250514

# Daily token budget for AI chat (across all users)
# Optional — defaults to 100000
AI_DAILY_TOKEN_BUDGET=100000

# Token budget for AI agent orchestrator workflows
# Optional — defaults to 50000
AGENT_WORKFLOW_TOKEN_BUDGET=50000

# --- Integrations: OpenAI ---

# OpenAI API key for knowledge base embedding generation (RAG search)
# Optional — embedding features disabled if not set
OPENAI_API_KEY=

# Embedding model for knowledge base vectors
# Optional — defaults to "text-embedding-3-small"
EMBEDDING_MODEL=text-embedding-3-small

# --- Integrations: CAQH ---

# CAQH ProView API (Basic Auth — base64 of username:password)
# Demo: CAQH_API_URL=https://proview-demo.nonprod.caqh.org  CAQH_ORG_ID=6279
# Prod: CAQH_API_URL=https://proview.caqh.org  CAQH_ORG_ID=1873
# NOTE: Base URL should NOT include /api — endpoint paths include the full path
CAQH_API_URL=
CAQH_ORG_ID=
CAQH_USERNAME=
CAQH_PASSWORD=
CAQH_PRODUCT=PV

# --- Integrations: Retell AI ---

# Retell API key for phone call follow-up feature — disabled if not set
# Optional
RETELL_API_KEY=

# Retell webhook signature secret for verifying inbound webhooks
# Optional
RETELL_WEBHOOK_SECRET=

# --- Integrations: Aetna ---

# Aetna FHIR Provider Directory API credentials
# Optional — Aetna directory features disabled if not set
AETNA_CLIENT_ID=
AETNA_CLIENT_SECRET=
AETNA_FHIR_BASE_URL=https://vteapif1.aetna.com/fhirdemo/v1/patientaccess

# Aetna OAuth token endpoint (overrides default derived from FHIR base URL)
# Optional
AETNA_TOKEN_URL=

# Aetna enrollment portal URL for form automation
# Optional — defaults to Aetna's public portal
AETNA_PORTAL_URL=

# --- Integrations: Linear (Bug Monitor) ---

# Linear API key for automated bug issue creation
# Optional — bug monitor disabled if not set
LINEAR_API_KEY=

# Linear team ID to file issues under
# Optional
LINEAR_TEAM_ID=

# Linear label ID to tag bug issues with
# Optional
LINEAR_BUG_LABEL_ID=

# Kill switch for bug monitor — set to "true" to enable, "false" to disable
# Optional — defaults to "false"
LINEAR_BUG_MONITOR_ENABLED=false

# Shared secret for CI/frontend → backend bug report authentication
# Optional
BUG_MONITOR_SECRET=

# Anthropic model for AI-powered bug triage
# Optional — defaults to "claude-haiku-4-5-20251001"
BUG_TRIAGE_MODEL=claude-haiku-4-5-20251001

# Email address for urgent bug alerts via SES
# Optional
BUG_ALERT_EMAIL=

# Occurrence threshold before creating a Linear issue (noise filtering)
# Optional — defaults to 10
BUG_MONITOR_NOISE_THRESHOLD=10

# --- Integrations: Sentry ---

# Sentry DSN for error monitoring
# Optional — error reporting disabled if not set
SENTRY_DSN=

# --- Schedules (cron expressions) ---

# Aetna directory check schedule
# Optional — defaults to "0 3 * * 0" (Sunday 3am)
DIRECTORY_CHECK_SCHEDULE=0 3 * * 0

# Credential expiration alert check (in-app notifications)
# Optional — defaults to "0 7 * * *" (daily 7am)
EXPIRATION_ALERT_SCHEDULE=0 7 * * *

# Credential expiration email notifications
# Optional — defaults to "0 8 * * *" (daily 8am)
EXPIRATION_EMAIL_SCHEDULE=0 8 * * *

# CAQH nightly auto-sync schedule
# Optional — defaults to "0 2 * * *" (daily 2am)
CAQH_SYNC_SCHEDULE=0 2 * * *

# Enrollment follow-up reminder schedule
# Optional — defaults to "0 9 * * *" (daily 9am)
FOLLOWUP_SCHEDULE=0 9 * * *
