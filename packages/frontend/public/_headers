# Security headers applied to every response
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self' https://kay-os62.onrender.com; font-src 'self'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# The HTML entrypoint must never be cached — it references hashed asset
# filenames that change every deploy. A cached index.html points the browser
# at chunks that no longer exist on the server and produces the
# "Failed to fetch dynamically imported module" / "Update Available" loop.
/index.html
  Cache-Control: no-cache, no-store, must-revalidate

# Same rule for the root path (which serves index.html via SPA fallback)
/
  Cache-Control: no-cache, no-store, must-revalidate

# Hashed build assets are content-addressed (the filename changes when the
# content changes), so they can be cached aggressively and immutably.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
