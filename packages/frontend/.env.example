# Required in dev — enables dev login bypass
VITE_DEV_AUTH_BYPASS=true

# NOT needed in dev — Vite proxy handles /api → localhost:3002
# Only set in production (must include /api/v1 suffix):
# VITE_API_URL=https://your-backend.onrender.com/api/v1

# Cognito (not needed when VITE_DEV_AUTH_BYPASS=true)
# VITE_COGNITO_USER_POOL_ID=us-east-1_xxxxx
# VITE_COGNITO_CLIENT_ID=xxxxx
