{
  "schema_version": "1.0.0",
  "last_updated": "2025-02-12",
  "data_sources": [
    "CAQH ProView documentation",
    "Payer provider enrollment portals (2024-2025)",
    "NCQA credentialing standards",
    "CMS Medicare provider enrollment guidelines"
  ],

  "global_prerequisites": {
    "caqh_proview": {
      "name": "CAQH ProView Profile",
      "url": "https://proview.caqh.org",
      "description": "Universal credentialing data repository used by all five payers. Must be completed and attested BEFORE initiating any payer application.",
      "required": true,
      "priority": "CRITICAL",
      "tasks": [
        {
          "id": "caqh-001",
          "name": "Create CAQH ProView account",
          "description": "Register at proview.caqh.org with NPI number",
          "estimated_minutes": 15,
          "dependencies": ["npi-001"]
        },
        {
          "id": "caqh-002",
          "name": "Complete personal information section",
          "description": "Legal name, DOB, SSN, contact information, practice addresses",
          "estimated_minutes": 30,
          "dependencies": ["caqh-001"]
        },
        {
          "id": "caqh-003",
          "name": "Upload professional documents",
          "description": "State license(s), DEA certificate, malpractice COI, board certifications, W-9",
          "estimated_minutes": 45,
          "dependencies": ["caqh-002"]
        },
        {
          "id": "caqh-004",
          "name": "Complete work history",
          "description": "5-year work history with all gaps explained (gap threshold varies by payer: >30 days for Aetna, >6 months for Cigna/UHC)",
          "estimated_minutes": 30,
          "dependencies": ["caqh-002"]
        },
        {
          "id": "caqh-005",
          "name": "Enter Professional IDs",
          "description": "NPI, DEA, state license numbers, Medicare PTAN (if applicable), Medicaid ID",
          "estimated_minutes": 15,
          "dependencies": ["caqh-002"]
        },
        {
          "id": "caqh-006",
          "name": "Authorize payer data sharing",
          "description": "Grant data access to each payer. CRITICAL: Each payer/subsidiary requires separate authorization",
          "estimated_minutes": 10,
          "dependencies": ["caqh-003", "caqh-004", "caqh-005"],
          "payer_specific_authorizations": {
            "aetna": ["Aetna"],
            "cigna_medical": ["Cigna Healthcare"],
            "cigna_bh": ["Evernorth Behavioral Health"],
            "uhc": ["UnitedHealthcare"],
            "optum_bh": ["United Behavioral Health"],
            "humana": ["Humana"]
          }
        },
        {
          "id": "caqh-007",
          "name": "Attest profile",
          "description": "Review all information for accuracy and electronically attest. Profile must remain attested throughout enrollment.",
          "estimated_minutes": 15,
          "dependencies": ["caqh-006"]
        }
      ],
      "re_attestation_schedules": {
        "default": { "days": 120, "label": "Every 120 days" },
        "humana": { "days": 180, "label": "Every 180 days" },
        "cigna_illinois": { "days": 180, "label": "Every 180 days (Illinois only)" }
      }
    },
    "npi": {
      "id": "npi-001",
      "name": "National Provider Identifier (NPI)",
      "url": "https://nppes.cms.hhs.gov",
      "required": true,
      "description": "Obtain Type 1 (individual) NPI from NPPES if not already assigned"
    },
    "medicare_enrollment": {
      "id": "medicare-001",
      "name": "Medicare Part B Enrollment (LPC/MFT)",
      "url": "https://pecos.cms.hhs.gov",
      "required_for": ["LPC", "LMHC", "MFT", "LMFT"],
      "required_when": "Medicare Advantage participation needed",
      "description": "As of January 1, 2024, LPCs and MFTs must enroll in Original Medicare via PECOS/CMS-855I and obtain a PTAN before any MA plan credentialing.",
      "requirements": {
        "degree": "Master's or doctoral degree",
        "license": "Current state licensure",
        "experience": "2 years / 3,000 hours post-master's supervised clinical experience"
      },
      "reimbursement_rate": "75% of psychologist rates"
    }
  },

  "required_documents": {
    "universal": [
      {
        "id": "doc-npi",
        "name": "NPI Number",
        "required_by": ["aetna", "cigna", "uhc", "optum", "humana"],
        "provider_types": "all"
      },
      {
        "id": "doc-license",
        "name": "Active Unrestricted State License(s)",
        "required_by": ["aetna", "cigna", "uhc", "optum", "humana"],
        "provider_types": "all",
        "validity_rules": {
          "cigna_bh": "Must be 60+ days from expiration at application",
          "humana": "Must be valid 45+ days into the future",
          "optum": "Must be independent licensure — no provisional or supervisory-dependent"
        }
      },
      {
        "id": "doc-dea",
        "name": "DEA Certificate",
        "required_by": ["aetna", "cigna", "uhc", "optum", "humana"],
        "provider_types": ["MD", "DO", "PMHNP", "PA"],
        "validity_rules": {
          "humana": "Must be valid 45+ days into the future"
        }
      },
      {
        "id": "doc-malpractice",
        "name": "Malpractice Insurance (Certificate of Insurance)",
        "required_by": ["aetna", "cigna", "uhc", "optum", "humana"],
        "provider_types": "all",
        "minimum_coverage": {
          "default": "$1M/$3M",
          "cigna_bh_non_prescribing": "$1M/$1M"
        },
        "validity_rules": {
          "humana": "Must be valid 45+ days into the future"
        }
      },
      {
        "id": "doc-w9",
        "name": "W-9 Form",
        "required_by": ["aetna", "cigna", "uhc", "optum", "humana"],
        "provider_types": "all",
        "notes": "UHC: Legal name and TIN must match IRS records exactly"
      },
      {
        "id": "doc-board-cert",
        "name": "Board Certification",
        "required_by": ["aetna", "cigna", "uhc", "optum", "humana"],
        "provider_types": ["MD", "DO"],
        "notes": "Required for physicians; status verified for all provider types"
      },
      {
        "id": "doc-cv",
        "name": "Curriculum Vitae / Work History",
        "required_by": ["aetna", "cigna", "uhc", "optum", "humana"],
        "provider_types": "all",
        "gap_thresholds": {
          "aetna": "Explain gaps > 30 days",
          "cigna": "Explain gaps > 6 months",
          "uhc": "Explain gaps > 6 months",
          "optum": "5-year history required",
          "humana": "Month/year format required"
        }
      },
      {
        "id": "doc-caqh",
        "name": "CAQH ProView Profile (Complete & Attested)",
        "required_by": ["aetna", "cigna", "uhc", "optum", "humana"],
        "provider_types": "all"
      }
    ],
    "payer_specific": [
      {
        "id": "doc-ptan",
        "name": "Medicare PTAN/CCN",
        "required_by": ["humana"],
        "required_for_plans": ["Medicare Advantage"],
        "also_recommended": ["uhc", "optum", "cigna"],
        "notes": "Critical for Humana MA participation. Enter in CAQH Professional IDs section."
      },
      {
        "id": "doc-peer-refs",
        "name": "Peer References (3)",
        "required_by": ["optum"],
        "provider_types": "all"
      },
      {
        "id": "doc-bh-profiling",
        "name": "Behavioral Health Profiling Form",
        "required_by": ["humana"],
        "provider_types": ["behavioral_health"]
      },
      {
        "id": "doc-collab-agreement",
        "name": "Collaborative Practice Agreement",
        "required_by": ["humana"],
        "provider_types": ["APRN", "PMHNP"],
        "notes": "Required in states that mandate collaborative agreements"
      },
      {
        "id": "doc-clia",
        "name": "CLIA Certificate",
        "required_by": ["humana"],
        "provider_types": ["MD", "DO"],
        "conditional": true,
        "notes": "Required if performing lab tests"
      },
      {
        "id": "doc-hospital-privileges",
        "name": "Hospital Privilege Letters",
        "required_by": ["aetna", "uhc", "humana"],
        "provider_types": ["MD", "DO"],
        "conditional": true,
        "notes": "If applicable / if admitting privileges held"
      }
    ]
  },

  "provider_types": {
    "medical": [
      { "code": "MD", "label": "Physician (MD)", "credentialable_by": ["aetna", "cigna", "uhc", "humana"] },
      { "code": "DO", "label": "Physician (DO)", "credentialable_by": ["aetna", "cigna", "uhc", "humana"] },
      { "code": "NP", "label": "Nurse Practitioner", "credentialable_by": ["aetna", "cigna", "uhc", "humana"] },
      { "code": "PA", "label": "Physician Assistant", "credentialable_by": ["aetna", "cigna", "uhc", "humana"] }
    ],
    "behavioral_health": [
      { "code": "PSYCH-MD", "label": "Psychiatrist (MD/DO)", "credentialable_by": ["aetna", "cigna_bh", "optum", "humana"] },
      { "code": "PHD-PSYD", "label": "Psychologist (PhD/PsyD)", "credentialable_by": ["aetna", "cigna_bh", "optum", "humana"] },
      { "code": "LCSW", "label": "Licensed Clinical Social Worker", "credentialable_by": ["aetna", "cigna_bh", "optum", "humana"] },
      { "code": "LPC", "label": "Licensed Professional Counselor", "credentialable_by": ["aetna", "cigna_bh", "optum", "humana"] },
      { "code": "LMHC", "label": "Licensed Mental Health Counselor", "credentialable_by": ["aetna", "cigna_bh", "optum", "humana"] },
      { "code": "LMFT", "label": "Licensed Marriage & Family Therapist", "credentialable_by": ["aetna", "cigna_bh", "optum", "humana"] },
      { "code": "PMHNP", "label": "Psychiatric Mental Health NP", "credentialable_by": ["aetna", "cigna_bh", "optum", "humana"] },
      { "code": "BCBA", "label": "Board Certified Behavior Analyst", "credentialable_by": ["optum", "humana"] },
      { "code": "BCABA", "label": "Board Certified Assistant Behavior Analyst", "credentialable_by": ["humana"] },
      { "code": "RBT", "label": "Registered Behavior Technician", "credentialable_by": ["humana"] },
      { "code": "CAC", "label": "Certified Addiction Counselor", "credentialable_by": ["aetna", "optum", "humana"] }
    ]
  },
  "enrollment_sequencing": {
    "recommended_order": [
      {
        "priority": 1,
        "payer": "cigna",
        "track": "behavioral_health",
        "rationale": "Fastest BH timelines (60-120 days), structured 21-day outreach commitment"
      },
      {
        "priority": 2,
        "payer": "optum",
        "track": "behavioral_health",
        "rationale": "Best status tracking, clear process. Start early to account for 5-30 day data loading lag."
      },
      {
        "priority": 2,
        "payer": "uhc",
        "track": "medical",
        "rationale": "Onboard Pro dashboard provides real-time tracking. Can run parallel with Optum BH."
      },
      {
        "priority": 3,
        "payer": "humana",
        "track": "both",
        "rationale": "Critical for Medicare Advantage patient access. Ensure Medicare PTAN is obtained first."
      },
      {
        "priority": 4,
        "payer": "aetna",
        "track": "both",
        "rationale": "Longest BH timelines (6-12 months). Start early but manage expectations."
      }
    ]
  },

  "interstate_compacts": [
    {
      "name": "PSYPACT",
      "provider_types": ["Psychologist"],
      "states_count": 43,
      "status": "Active",
      "notes": "Some payer platforms don't yet recognize PSYPACT for credentialing"
    },
    {
      "name": "Counseling Compact",
      "provider_types": ["LPC"],
      "states_count": 38,
      "status": "Applications opening 2025",
      "notes": "Will expand multi-state practice for LPCs"
    },
    {
      "name": "Social Work Compact",
      "provider_types": ["LCSW"],
      "states_count": 22,
      "status": "Applications anticipated Fall 2025",
      "notes": "Newest of the three compacts"
    }
  ],

  "ncqa_2025_updates": {
    "effective_date": "2025-07-01",
    "changes": [
      "Verification timeframes shortened from 180 to 120 days (health plan accreditation)",
      "Certification verification shortened to 90 days",
      "Monthly SAM.gov exclusion checks mandatory",
      "New 'information integrity' standards replace previous must-pass elements",
      "Annual auditing with 3-6 month follow-up required"
    ]
  },

