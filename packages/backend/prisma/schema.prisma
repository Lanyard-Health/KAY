// ==========================================
// ENROLLMENT WORKFLOW STEPS
// ==========================================

model EnrollmentWorkflowStep {
  id           String @id @default(uuid())
  enrollmentId String @map("enrollment_id")

  // Template reference
  templateStepId String    @map("template_step_id")
  stepOrder      Int       @map("step_order")
  dueDate        DateTime? @map("due_date")

  // Step details (copied from template at creation time)
  name          String
  description   String             @db.Text
  actionType    WorkflowActionType @map("action_type")
  url           String?
  owner         WorkflowStepOwner
  estimatedDays Int                @map("estimated_days")

  // Dependencies & requirements
  dependencies    String[] @default([])
  documentsNeeded String[] @default([]) @map("documents_needed")
  warnings        String[] @default([])

  // Progress tracking
  status        WorkflowStepStatus @default(not_started)
  startedAt     DateTime?          @map("started_at")
  completedAt   DateTime?          @map("completed_at")
  completedById String?            @map("completed_by_id")
  skippedReason String?            @map("skipped_reason")
  notes         String?

  // Audit
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  enrollment  Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  completedBy User?      @relation("WorkflowStepCompletedBy", fields: [completedById], references: [id])
  approvals   PendingApproval[]

  @@index([enrollmentId])
  @@index([status])
  @@index([enrollmentId, stepOrder])
  @@map("enrollment_workflow_steps")
}

