model ProviderSpecialty {
  id               String   @id @default(uuid())
  providerId       String   @map("provider_id")
  specialtyId      String   @map("specialty_id")
  isPrimary        Boolean  @default(false) @map("is_primary")
  nuccTaxonomyCode String?  @map("nucc_taxonomy_code")
  caqhSpecialtyId  String?  @map("caqh_specialty_id")
  source           CredentialSource @default(manual_entry)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  provider  ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  specialty Specialty       @relation(fields: [specialtyId], references: [id], onDelete: Cascade)

  @@unique([providerId, specialtyId])
  @@index([providerId])
  @@index([providerId, caqhSpecialtyId])
  @@map("provider_specialties")
}

model ProviderSubSpecialty {
  id             String   @id @default(uuid())
  providerId     String   @map("provider_id")
  subSpecialtyId String   @map("sub_specialty_id")
  createdAt      DateTime @default(now()) @map("created_at")

  provider     ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  subSpecialty SubSpecialty    @relation(fields: [subSpecialtyId], references: [id], onDelete: Cascade)

  @@unique([providerId, subSpecialtyId])
  @@index([providerId])
  @@map("provider_sub_specialties")
}

model ProviderService {
