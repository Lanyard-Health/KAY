// ==========================================
// AUTONOMOUS AGENT SYSTEM
// ==========================================

enum AgentWorkflowStatus {
  planning
  active
  paused
  waiting_approval
  completed
  failed
  cancelled
}

enum AgentTaskStatus {
  pending
  queued
  in_progress
  completed
  failed
  skipped
  cancelled
}

enum ApprovalStatus {
  pending
  approved
  denied
  expired
}

enum TaxonomySection {
  INDIVIDUAL
  NON_INDIVIDUAL
}

enum ServiceDomain {
  BEHAVIORAL_HEALTH
  WOMENS_HEALTH
  PRIMARY_CARE
}

enum CustomServiceStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

model AgentWorkflow {
  id         String              @id @default(uuid())
  goal       String
  goalParams Json                @map("goal_params")
  status     AgentWorkflowStatus @default(planning)
  priority   String              @default("normal")
  plan       Json?

  // Atomic counter for replan attempts. Promoted from plan.replanCount JSON
  // path to a top-level Int column so we can use Prisma's atomic { increment }
  // operator under concurrency=3. Mirrored back into plan JSON for one-release
  // rollback safety; remove the JSON mirror in a follow-up after burn-in.
  replanCount Int @default(0) @map("replan_count")

  // Relations
  providerId   String          @map("provider_id")
  provider     ProviderProfile @relation(fields: [providerId], references: [id])
  practiceId   String          @map("practice_id")
  practice     Practice        @relation(fields: [practiceId], references: [id])
  payerId      String?         @map("payer_id")
  payer        Payer?          @relation(fields: [payerId], references: [id])
  enrollmentId String?         @map("enrollment_id")
  requestedBy  String          @map("requested_by")
  requester    User            @relation("WorkflowRequester", fields: [requestedBy], references: [id])

  // Child relations
  tasks     AgentTask[]
  events    AgentEvent[]
  actions   AgentAction[]
  approvals PendingApproval[]

  // Timestamps
  startedAt    DateTime? @map("started_at")
  completedAt  DateTime? @map("completed_at")
  cancelledAt  DateTime? @map("cancelled_at")
  cancelReason String?   @map("cancel_reason")

  // Metrics
  totalTokensUsed Int  @default(0) @map("total_tokens_used")
  totalDurationMs Int? @map("total_duration_ms")

  // Audit
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([providerId])
  @@index([requestedBy])
  @@map("agent_workflows")
}

model AgentTask {
  id         String        @id @default(uuid())
  workflowId String        @map("workflow_id")
  workflow   AgentWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  type      String
  agentType String          @map("agent_type")
  status    AgentTaskStatus @default(pending)

  input  Json
  output Json?
  error  Json?

  stepNumber       Int      @map("step_number")
  dependsOn        String[] @default([]) @map("depends_on")
  requiresApproval Boolean  @default(false) @map("requires_approval")

  // BullMQ tracking
  bullmqJobId String? @map("bullmq_job_id")
  queue       String?

  // Retry
  attempts    Int @default(0)
  maxAttempts Int @default(3) @map("max_attempts")

  // Timing
  queuedAt    DateTime? @map("queued_at")
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")

  // Stalled-task watchdog (Tier 1 #3 — recovers jobs lost on Redis restart/deploy).
  // Set by the watchdog cron when an in_progress task exceeds its queue's
  // lockDuration + a 10-minute buffer. NULL until first detection so the cron
  // doesn't reprocess the same task on every tick.
  stalledDetectedAt DateTime? @map("stalled_detected_at")

  // Idempotency key (Tier 2 #9 — prevents duplicate submissions on retry).
  // Defaults to SHA-256 of `workflowId + type + JSON.stringify(input)`; callers
  // may also pass an explicit key. Unique per workflow so the same dedupe
  // string is fine across different workflows. NULL is allowed so existing
  // rows pre-migration don't violate the unique constraint.
  dedupeKey String? @map("dedupe_key")

  // Metrics
  tokensUsed Int @default(0) @map("tokens_used")

  // Audit
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([workflowId, dedupeKey])
  @@index([workflowId, status])
  @@index([agentType, status])
  @@index([bullmqJobId])
  @@index([status, startedAt])
  @@map("agent_tasks")
}

model AgentEvent {
  id         String        @id @default(uuid())
  workflowId String        @map("workflow_id")
  workflow   AgentWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  taskId    String?  @map("task_id")
  agent     String
  action    String
  data      Json
  level     String   @default("info")
  timestamp DateTime @default(now())

  // Phase 0.A — chain-and-sign columns. All nullable so:
  //   (a) existing rows backfill as NULL (no signatures pre-migration),
  //   (b) shadow-mode failures leave NULL columns + Sentry warning,
  //   (c) the first new event of a pre-existing workflow has prevHash=NULL.
  // signatureKeyId='unsigned' marks events that were attempted but failed
  // to sign in enforce mode (paged via Sentry P1).
  signature      String? // base64 Ed25519 signature over canonical payload incl. prevHash
  signatureKeyId String? @map("signature_key_id") // matches a key in /.well-known/lanyard-signing-keys.json or 'unsigned'
  prevHash       String? @map("prev_hash") // SHA-256 hex of previous event in workflow; NULL for chain head
  eventHash      String? @map("event_hash") // SHA-256 hex over canonical payload incl. prevHash

  @@unique([workflowId, eventHash], map: "agent_events_workflow_id_event_hash_key")
  @@index([workflowId, timestamp])
  @@index([agent, action])
  @@map("agent_events")
}

// Per-action telemetry for every BullMQ agent processor run (Phase 0.A PR 3).
// One row per processor invocation, written by the withAgentTelemetry wrapper
// in agents/workers.ts. Survives workflow / practice / provider deletion
// (onDelete: SetNull) so cost-and-SLO reporting stays intact for billing
// rollups and capacity planning.
model AgentAction {
  id String @id @default(uuid())

  // Relations — all nullable so a deleted workflow / practice / provider
  // does not erase its historical telemetry. Direct FK index added on
  // workflowId for workflow drill-downs; (practiceId, createdAt) and
  // (providerId, createdAt) cover the billing / per-provider reports.
  workflowId String?          @map("workflow_id")
  workflow   AgentWorkflow?   @relation(fields: [workflowId], references: [id], onDelete: SetNull)
  taskId     String?          @map("task_id") // free-form, no FK (matches AgentEvent.taskId convention)
  practiceId String?          @map("practice_id")
  practice   Practice?        @relation(fields: [practiceId], references: [id], onDelete: SetNull)
  providerId String?          @map("provider_id")
  provider   ProviderProfile? @relation(fields: [providerId], references: [id], onDelete: SetNull)

  // Dimensions
  agentName  String @map("agent_name")  // e.g. "orchestrator", "document_parser"
  actionType String @map("action_type") // e.g. "process_job"

  // Outcome
  success       Boolean
  errorCategory String? @map("error_category") // e.g. "timeout", "auth_error", "validation", "downstream_5xx"
  durationMs    Int     @map("duration_ms")

  // Cost — token counts default 0 for non-AI agents; costCents derived via utils/ai-pricing.ts.
  inputTokens  Int     @default(0) @map("input_tokens")
  outputTokens Int     @default(0) @map("output_tokens")
  costCents    Decimal @default(0) @map("cost_cents") @db.Decimal(10, 4)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([agentName, createdAt])
  @@index([practiceId, createdAt])
  @@index([providerId, createdAt])
  @@index([workflowId])
  @@map("agent_actions")
}

// Outbound webhook subscriptions (Phase 0.A PR 4).
// Each row registers an external endpoint that wants to receive events
// (agent_event.created, enrollment.status_changed, credential.expired).
// Per-subscription HMAC secret stored encrypted via encryptSafe; the
// plaintext secret is returned exactly once at creation time.
//
// onDelete behavior:
//   practice → Cascade: subscriptions are practice-owned; if the practice
//     is deleted, take the subscriptions with it (no value preserving an
//     orphaned endpoint that would never be re-authorized).
//   createdBy → SetNull: preserve the audit trail when a user is deleted.
//
// Soft-delete via deletedAt (not status) so DELETE keeps history rows
// joinable for forensic / billing review of past deliveries.
model WebhookSubscription {
  id String @id @default(uuid())

  practiceId String   @map("practice_id")
  practice   Practice @relation(fields: [practiceId], references: [id], onDelete: Cascade)

  url             String
  eventTypes      String[] @default([]) @map("event_types")
  secretEncrypted String   @map("secret_encrypted") // AES-256-GCM via encryptSafe
  description     String?
  active          Boolean  @default(true)

  // Audit
  createdById String? @map("created_by_id")
  createdBy   User?   @relation("WebhookSubscriptionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  // Observability — surfaced on the subscription dashboard so practice
  // admins can see whether their endpoint is healthy without needing to
  // page through delivery history.
  lastDeliveryAt      DateTime? @map("last_delivery_at")
  lastFailureAt       DateTime? @map("last_failure_at")
  consecutiveFailures Int       @default(0) @map("consecutive_failures")

  // Timestamps
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // Children
  deliveries WebhookDelivery[]

  @@index([practiceId, deletedAt])
  @@index([active])
  @@map("webhook_subscriptions")
}

// One row per outbound delivery attempt sequence (Phase 0.A PR 4).
// Mutated as BullMQ retries: attemptCount + lastAttemptAt + responseStatus
// + responseSnippet update on each attempt; status settles to
// 'delivered' (2xx success), 'failed' (transient — will retry), or
// 'dead' (BullMQ exhausted retry budget — DLQ marker).
//
// responseSnippet capped at 2 KB at write time per Phase 0.A Addition 1.
//
// onDelete: Cascade on subscription so a hard-deleted subscription drops
// its delivery history. Soft-delete (preferred) preserves rows because
// the FK still resolves.
model WebhookDelivery {
  id String @id @default(uuid())

  subscriptionId String              @map("subscription_id")
  subscription   WebhookSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  eventType String  @map("event_type") // e.g. "agent_event.created"
  eventId   String? @map("event_id")   // optional reference to source row id (free-form, no FK)
  payload   Json

  status       String   @default("pending") // pending | delivered | failed | dead
  attemptCount Int      @default(0) @map("attempt_count")

  // Latest-attempt fields — overwritten on each retry. Forensics on the
  // full attempt sequence live in BullMQ job logs; this column captures
  // the terminal-state response that operators need for triage.
  lastAttemptAt   DateTime? @map("last_attempt_at")
  responseStatus  Int?      @map("response_status")
  responseSnippet String?   @map("response_snippet") // capped at 2 KB at write time
  errorMessage    String?   @map("error_message")

  createdAt   DateTime  @default(now()) @map("created_at")
  deliveredAt DateTime? @map("delivered_at")

  @@index([subscriptionId, createdAt])
  @@index([status])
  @@index([eventType])
  @@map("webhook_deliveries")
}

model PendingApproval {
  id String @id @default(uuid())

  // Agent workflow approval (original use case — now optional)
  workflowId String?        @map("workflow_id")
