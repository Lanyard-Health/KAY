// ==========================================
// AUDIT LOGGING (SOC 2)
// ==========================================

enum AuditAction {
  // Existing values — DO NOT REMOVE OR RENAME
  create
  read
  update
  delete
  login
  logout
  export
  import

  // Submission engine — added Phase 1
  SUBMISSION_QUEUED             // Job enqueued in BullMQ: enrollmentRunId, payerId, adapterType
  SUBMISSION_STARTED            // Worker picked up job: enrollmentRunId, attemptNumber
  SUBMISSION_SKIPPED_IDEMPOTENT // Pre-flight guard fired: enrollmentRunId, currentStatus
  SUBMISSION_FORM_FILLED        // Adapter finished filling fields: enrollmentRunId, fieldCount
  SUBMISSION_SUBMITTED          // Submit button clicked: enrollmentRunId, preScreenshotKey
  SUBMISSION_CONFIRMED          // Portal confirmed receipt: enrollmentRunId, confirmationNumber, postScreenshotKey
  SUBMISSION_ATTEMPT_FAILED     // One attempt failed, retrying: enrollmentRunId, attemptNumber, errorMessage
  SUBMISSION_DEAD_LETTERED      // All attempts exhausted: enrollmentRunId, finalErrorMessage
}

model AuditLog {
  id String @id @default(uuid())

  userId       String?     @map("user_id")
  action       AuditAction
  resourceType String      @map("resource_type")
  resourceId   String?     @map("resource_id")
  changes      Json?
  ipAddress    String?     @map("ip_address")
  userAgent    String?     @map("user_agent")
  timestamp    DateTime    @default(now())

  // Relations
  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([resourceType])
  @@index([timestamp])
  @@map("audit_logs")
}

