// ==========================================
// KNOWLEDGE BASE — PAYER TRACK
// ==========================================

model PayerTrack {
  id              String   @id @default(cuid())
  payerName       String   @map("payer_name")
  parentOrg       String?  @map("parent_org")
  payerType       String   @map("payer_type") // Commercial | Government | Medicaid
  stateRegion     String   @map("state_region") // "Nationwide" or specific state
  track           String   // e.g. "Behavioral Health — Individual"
  submissionMethod String  @map("submission_method") // caqh | portal | web_form | email_pdf | pecos | playwright | phone
  enrollmentLink  String?  @map("enrollment_link")
  portalUrl       String?  @map("portal_url")
  productLines    String[] @default([]) @map("product_lines")
  notes           String?
  isActive        Boolean  @default(true) @map("is_active")

  // Relations
  contacts           PayerContact[]
  timelines          PayerTimeline[]
  stateRules         PayerStateRule[]
  forms              PayerForm[]
  requirements       PayerRequirement[]
  enrollments        Enrollment[]
  workflowTemplates  WorkflowTemplate[]
  followUpTemplates  FollowUpTemplate[]
  embeddings         KnowledgeBaseEmbedding[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([payerName, track, stateRegion])
  @@map("payer_tracks")
}

model PayerContact {
  id            String    @id @default(cuid())
  payerTrackId  String    @map("payer_track_id")
  payerTrack    PayerTrack @relation(fields: [payerTrackId], references: [id], onDelete: Cascade)
  contactType   String    @map("contact_type") // Credentialing | Provider Services | Status Check
  phone         String?
  email         String?
  fax           String?
  portalUrl     String?   @map("portal_url")
  hours         String?
  notes         String?
  createdAt     DateTime  @default(now()) @map("created_at")

  @@map("payer_contacts")
}

model PayerTimeline {
  id            String    @id @default(cuid())
  payerTrackId  String    @map("payer_track_id")
  payerTrack    PayerTrack @relation(fields: [payerTrackId], references: [id], onDelete: Cascade)
  processType   String    @map("process_type") // Initial | Recredential | Contract Loading
  minDays       Int?      @map("min_days")
  maxDays       Int?      @map("max_days")
  stateOverrides Json?    @map("state_overrides") // { "MD": 15, "OH": 15 }
  notes         String?
  createdAt     DateTime  @default(now()) @map("created_at")

  embeddings    KnowledgeBaseEmbedding[]

  @@map("payer_timelines")
}

model PayerStateRule {
  id            String    @id @default(cuid())
  payerTrackId  String    @map("payer_track_id")
  payerTrack    PayerTrack @relation(fields: [payerTrackId], references: [id], onDelete: Cascade)
  state         String
  ruleType      String    @map("rule_type") // open_enrollment_window | alternate_application | insurance_minimum | caqh_override | network_alliance
  description   String
  effectiveDate DateTime? @map("effective_date")
  expirationDate DateTime? @map("expiration_date")
  createdAt     DateTime  @default(now()) @map("created_at")

  embeddings    KnowledgeBaseEmbedding[]

  @@map("payer_state_rules")
}

model PayerForm {
