model Payer {
  id String @id @default(uuid())

  name         String
  payerId      String  @unique @map("payer_id")
  payerType    String  @map("payer_type")
  addressLine1 String? @map("address_line_1")
  city         String?
  state        String?
  zipCode      String? @map("zip_code")
  phone        String?
  website      String?
  notes        String?

  verticalTags          String[] @default([]) @map("vertical_tags")
  averageProcessingDays Int?     @map("average_processing_days")

  // Credential ownership for this payer's portal login. GROUP = one login
  // per (payer, practice) — Availity, MCO portals. INDIVIDUAL = one login
  // per (payer, provider) — CAQH, some payer portals. resolveCredential()
  // in credential.service.ts dispatches lookup based on this value.
  credentialType PortalCredentialType @default(GROUP) @map("credential_type")

  // Audit
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  enrollments       Enrollment[]
  agentWorkflows    AgentWorkflow[]
  submissionConfig  PayerSubmissionConfig?
  practicePayers    PracticePayer[]
  portalCredentials PortalCredential[]

  @@map("payers")
}

// PracticePayer — per-(practice, payer) relationship metadata. Home for
// info the payer assigns at the practice level (group NPI, group tax ID,
// group contract) plus compliance artifacts (W-9, COI) that are shared
// across every provider in the practice when enrolling with that payer.
model PracticePayer {
  id         String @id @default(uuid())
  practiceId String @map("practice_id")
  payerId    String @map("payer_id")

  // Payer-assigned identifiers (practice scope)
  groupNpi            String? @map("group_npi")
  groupTaxIdEncrypted String? @map("group_tax_id_encrypted") // AES-256-GCM
  groupContractNumber String? @map("group_contract_number")

  // Primary contact for this practice-payer relationship
  primaryContactName  String? @map("primary_contact_name")
  primaryContactEmail String? @map("primary_contact_email")
  primaryContactPhone String? @map("primary_contact_phone")

  // Document S3 keys (private bucket; signed URLs only)
  coiOnFileUrl String? @map("coi_on_file_url")
  w9OnFileUrl  String? @map("w9_on_file_url")

  effectiveDate DateTime? @map("effective_date")
  notes         String?

  // Audit
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  practice Practice @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  payer    Payer    @relation(fields: [payerId], references: [id], onDelete: Cascade)

  @@unique([practiceId, payerId])
  @@index([payerId])
  @@map("practice_payers")
}

enum EnrollmentStatus {
  not_started
  in_progress
  submitted
  pending_review
  approved
  denied
  terminated
}

model Enrollment {
  id         String @id @default(uuid())
  providerId String @map("provider_id")
  payerId    String @map("payer_id")

  status               EnrollmentStatus @default(not_started)
  productTypes         String[]         @default([]) @map("product_types")
  applicationDate      DateTime?        @map("application_date")
  effectiveDate        DateTime?        @map("effective_date")
  terminationDate      DateTime?        @map("termination_date")
  dateContractReceived DateTime?        @map("date_contract_received")
  dateContractSigned   DateTime?        @map("date_contract_signed")
  lastFollowUpDate     DateTime?        @map("last_follow_up_date")
  recredentialingDate  DateTime?        @map("recredentialing_date")
  providerNumber       String?          @map("provider_number")
  groupNumber          String?          @map("group_number")
  confirmationNumber   String?          @map("confirmation_number") // pre-existing column — added to schema 2026-05-30 to resolve drift
  notes                String?
  payerEmail           String?          @map("payer_email")

  // Automated Follow-up Settings
  followUpEnabled       Boolean   @default(false) @map("follow_up_enabled")
  followUpEmail         String?   @map("follow_up_email")
  followUpFrequencyDays Int       @default(14) @map("follow_up_frequency_days")
  lastFollowUpSentAt    DateTime? @map("last_follow_up_sent_at")
  nextFollowUpDate      DateTime? @map("next_follow_up_date")

  // Workflow
  workflowType WorkflowType? @map("workflow_type")

  // Draft enrollments: auto-created from Practice.targetPayerIds when a
  // provider is added. Flips to false when staff first edits real data.
  isDraft Boolean @default(false) @map("is_draft")

  slaTargetDate DateTime? @map("sla_target_date")
  slaBreachedAt DateTime? @map("sla_breached_at")

  // PayerTrack + WorkflowTemplate linkage
  payerTrackId       String? @map("payer_track_id")
  workflowTemplateId String? @map("workflow_template_id")

  // Audit
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdById String?  @map("created_by_id")
  updatedById String?  @map("updated_by_id")
  createdBy   User?    @relation("EnrollmentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy   User?    @relation("EnrollmentUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  // Relations
  provider          ProviderProfile          @relation(fields: [providerId], references: [id], onDelete: Cascade)
  payer             Payer                    @relation(fields: [payerId], references: [id])
  payerTrack        PayerTrack?              @relation(fields: [payerTrackId], references: [id])
  workflowTemplate  WorkflowTemplate?        @relation(fields: [workflowTemplateId], references: [id])
  aiRecommendations AiRecommendation[]
  tasks             Task[]
  workflowSteps     EnrollmentWorkflowStep[]
  aetnaRuns         AetnaEnrollmentRun[]
  enrollmentRuns    EnrollmentRun[]
  followUpRuns      FollowUpRun[]
  denialTriages     DenialTriage[]

  @@unique([providerId, payerId])
  @@index([status])
  @@index([payerId])
  @@map("payer_enrollments")
}

