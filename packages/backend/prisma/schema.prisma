// ==========================================
// TERMINATION WORKFLOW
// ==========================================

enum TaskType {
  TERMINATE_ENROLLMENT
  CHECK_AVAILITY
  UPDATE_CAQH
  DRAFT_TERM_LETTER
  CUSTOM
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

enum TerminationLetterStatus {
  DRAFT
  REVIEWED
  SENT
}

model Task {
  id            String     @id @default(uuid())
  providerId    String     @map("provider_id")
  enrollmentId  String?    @map("enrollment_id")
  title         String
  description   String?
  type          TaskType
  status        TaskStatus @default(PENDING)
  assignedToId  String?    @map("assigned_to_id")
  dueDate       DateTime?  @map("due_date")
  completedAt   DateTime?  @map("completed_at")
  completedById String?    @map("completed_by_id")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  provider           ProviderProfile     @relation(fields: [providerId], references: [id], onDelete: Cascade)
  enrollment         Enrollment?         @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)
  assignedTo         User?               @relation("TaskAssignedTo", fields: [assignedToId], references: [id])
  completedBy        User?               @relation("TaskCompletedBy", fields: [completedById], references: [id])
  terminationLetters TerminationLetter[]

  @@index([providerId])
  @@index([enrollmentId])
  @@index([status])
  @@index([type])
  @@map("tasks")
}

model TerminationLetter {
  id            String                  @id @default(uuid())
  providerId    String                  @map("provider_id")
  taskId        String                  @map("task_id")
  payerName     String                  @map("payer_name")
  payerEmail    String?                 @map("payer_email")
  providerName  String                  @map("provider_name")
  npi           String
  groupNpi      String?                 @map("group_npi")
  taxIdEncrypted String                 @map("tax_id_encrypted") // Encrypted AES-256-GCM
  letterContent String                  @map("letter_content") @db.Text
  status        TerminationLetterStatus @default(DRAFT)
  reviewedById  String?                 @map("reviewed_by_id")
  reviewedAt    DateTime?               @map("reviewed_at")
  sentAt        DateTime?               @map("sent_at")
  createdAt     DateTime                @default(now()) @map("created_at")
  updatedAt     DateTime                @updatedAt @map("updated_at")

  provider   ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  task       Task            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  reviewedBy User?           @relation("TermLetterReviewedBy", fields: [reviewedById], references: [id])

  @@index([providerId])
  @@index([taskId])
  @@map("termination_letters")
}

