// Healthcare Credentialing Database Schema
// PostgreSQL database with full audit trail for SOC 2 compliance

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// USER MANAGEMENT
// ==========================================

enum UserRole {
  admin
  credentialing_staff
  provider
}

enum PracticeStatus {
  ACTIVE
  INACTIVE
}

enum PracticeRole {
  SUPER_ADMIN
  PRACTICE_ADMIN
  PRACTICE_STAFF
  PROVIDER
}

model User {
  id          String    @id @default(uuid())
  cognitoId   String    @unique @map("cognito_id")
  email       String    @unique
  firstName   String    @map("first_name")
  lastName    String    @map("last_name")
  phone       String?
  role        UserRole
  isActive    Boolean   @default(true) @map("is_active")
  lastLoginAt DateTime? @map("last_login_at")

  // Link to provider if role is 'provider'
  providerId String?   @unique @map("provider_id")
  provider   Provider? @relation(fields: [providerId], references: [id])

  // Audit
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  auditLogs        AuditLog[]
  documentsCreated Document[]           @relation("DocumentCreatedBy")
  documentsReviewed Document[]          @relation("DocumentReviewedBy")
  documentsReviewedAsReviewer Document[] @relation("DocumentReviewer")
  rosterTemplates  RosterTemplate[]
  tasksAssigned        Task[]              @relation("TaskAssignedTo")
  tasksCompleted       Task[]              @relation("TaskCompletedBy")
  termLettersReviewed  TerminationLetter[] @relation("TermLetterReviewedBy")
  practices            UserPractice[]
  inAppNotifications   InAppNotification[]
  workflowStepsCompleted EnrollmentWorkflowStep[] @relation("WorkflowStepCompletedBy")

  @@map("users")
}

// ==========================================
// PRACTICE (MULTI-TENANT)
// ==========================================

model Practice {
  id        String          @id @default(uuid())
  name      String
  status    PracticeStatus  @default(ACTIVE)
  phone     String?
  email     String?
  website   String?
  notes     String?
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  users              UserPractice[]
  providers              Provider[]
  providerApplications   ProviderApplication[]
  practiceLocations      PracticeLocation[]

  @@map("practices")
}

model UserPractice {
  id         String       @id @default(uuid())
  userId     String       @map("user_id")
  practiceId String       @map("practice_id")
  role       PracticeRole
  createdAt  DateTime     @default(now()) @map("created_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  practice Practice @relation(fields: [practiceId], references: [id], onDelete: Cascade)

  @@unique([userId, practiceId])
  @@index([practiceId])
  @@map("user_practices")
}

// ==========================================
// PROVIDER
// ==========================================

enum ProviderStatus {
  active
  inactive
  pending
}

enum Gender {
  male
  female
  other
  prefer_not_to_say
}

enum ProviderType {
  psychiatrist
  psychologist
  lcsw
  lpc
  lmft
  pmhnp
  other
}

enum CaqhStatus {
  active
  inactive
  pending
  expired
}

// ==========================================
// ENROLLMENT WORKFLOW
// ==========================================

enum WorkflowType {
  medical
  behavioral_health
}

enum WorkflowStepStatus {
  not_started
  in_progress
  completed
  skipped
  blocked
}

enum WorkflowActionType {
  form_submission
  phone_call
  caqh_update
  portal_registration
  document_upload
  waiting_period
  follow_up
  verification
  payer_review
  payer_outreach
  payer_internal
  committee_review
  contract_execution
  contract_delivery
  document_review
  site_visit
  system_processing
  routing_decision
  confirmation
  account_creation
}

enum WorkflowStepOwner {
  provider
  credentialing_staff
  payer
  cvo
}

model Provider {
  id String @id @default(uuid())

  // Basic Info
  npi        String  @unique
  firstName  String  @map("first_name")
  lastName   String  @map("last_name")
  middleName String? @map("middle_name")
  suffix     String?
  maidenName String? @map("maiden_name")

  // Personal Info
  dateOfBirth DateTime @map("date_of_birth")
  gender      Gender
  ssnEncrypted String? @map("ssn_encrypted") // Encrypted SSN

  // Contact
  email       String
  phone       String
  mobilePhone String? @map("mobile_phone")
  fax         String?

  // Professional
  providerType ProviderType @map("provider_type")
  taxonomy     String?
  specialties  String[]     @default([])
  languages    String[]     @default([])

  // CAQH Integration
  caqhProviderId       String?     @map("caqh_provider_id")
  caqhStatus           CaqhStatus? @map("caqh_status")
  caqhLastSync         DateTime?   @map("caqh_last_sync")
  caqhUsername         String?     @map("caqh_username")
  caqhPassword         String?     @map("caqh_password") // Encrypted
  caqhCredentialsValid Boolean?    @map("caqh_credentials_valid")
  caqhCredentialsLastChecked DateTime? @map("caqh_credentials_last_checked")

  // Directory change tracking (golden record for PDM)
  lastDirectoryUpdateAt DateTime? @map("last_directory_update_at")

  // Status
  status ProviderStatus @default(pending)

  // Onboarding
  onboardingCompletedAt DateTime? @map("onboarding_completed_at")

  // Audit
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdById String?  @map("created_by_id")
  updatedById String?  @map("updated_by_id")

  // Multi-tenant
  practiceId  String?  @map("practice_id")

  // Relations
  user                   User?
  addresses              ProviderAddress[]
  practiceLocations      PracticeLocation[]
  licenses               License[]
  boardCertifications    BoardCertification[]
  malpracticeInsurances  MalpracticeInsurance[]
  educations             Education[]
  workHistories          WorkHistory[]
  hospitalAffiliations   HospitalAffiliation[]
  professionalReferences ProfessionalReference[]
  disciplinaryActions    DisciplinaryAction[]
  continuingEducations   ContinuingEducation[]
  documents              Document[]
  payerEnrollments       PayerEnrollment[]
  checklist              ProviderChecklist?
  applications           ProviderApplication[]
  tasks                  Task[]
  terminationLetters     TerminationLetter[]
  aiRecommendations      AiRecommendation[]
  directorySnapshots     ProviderDirectorySnapshot[]
  directoryAlerts        ProviderDirectoryAlert[]
  practice               Practice?  @relation(fields: [practiceId], references: [id])

  @@map("providers")
}

model ProviderAddress {
  id         String @id @default(uuid())
  providerId String @map("provider_id")

  type         AddressType
  addressLine1 String      @map("address_line_1")
  addressLine2 String?     @map("address_line_2")
  city         String
  state        String
  zipCode      String      @map("zip_code")
  country      String      @default("US")
  isPrimary    Boolean     @default(false) @map("is_primary")

  // Audit
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@map("provider_addresses")
}

enum AddressType {
  home
  practice
  mailing
  billing
}

// ==========================================
// PRACTICE LOCATIONS
// ==========================================

model PracticeLocation {
  id         String @id @default(uuid())
  providerId String @map("provider_id")

  // Location Details
  locationName  String  @map("location_name")
  locationType  String  @map("location_type") // e.g., "office", "telehealth", "hospital"
  isPrimary     Boolean @default(false) @map("is_primary")
  isActive      Boolean @default(true) @map("is_active")

  // Address
  addressLine1  String  @map("address_line_1")
  addressLine2  String? @map("address_line_2")
  city          String
  state         String
  zipCode       String  @map("zip_code")
  county        String?
  country       String  @default("US")

  // Contact
  phone         String
  fax           String?
  email         String?

  // Business Info
  taxId         String? @map("tax_id")
  npi           String? // Location-specific NPI if different from provider
  groupNpi      String? @map("group_npi")

  // Hours (JSON object with day: {open, close} format)
  officeHours   Json?   @map("office_hours")

  // Accessibility
  wheelchairAccessible Boolean @default(false) @map("wheelchair_accessible")
  publicTransitAccess  Boolean @default(false) @map("public_transit_access")
  parkingAvailable     Boolean @default(true) @map("parking_available")

  // Additional Info
  acceptingNewPatients Boolean @default(true) @map("accepting_new_patients")
  languagesSpoken      String[] @default([])   @map("languages_spoken")
  specialServices      String[] @default([])   @map("special_services")
  notes                String?

  // Directory change tracking (golden record for PDM)
  lastDirectoryUpdateAt DateTime? @map("last_directory_update_at")

  // Audit
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdById String?  @map("created_by_id")
  updatedById String?  @map("updated_by_id")

  // Multi-tenant
  practiceId  String?  @map("practice_id")

  // Relations
  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  practice Practice? @relation(fields: [practiceId], references: [id])

  @@map("practice_locations")
}

// ==========================================
// CREDENTIALS
// ==========================================

enum CredentialStatus {
  active
  expired
  pending
  revoked
}

enum CredentialSource {
  manual_entry
  caqh_sync
  portal_import
}

enum LicenseType {
  state_medical
  state_psychology
  state_social_work
  state_counseling
  state_marriage_family
  dea
  controlled_substance
  npi
}

model License {
  id         String @id @default(uuid())
  providerId String @map("provider_id")

  licenseType        LicenseType      @map("license_type")
  licenseNumber      String           @map("license_number")
  state              String?
  issueDate          DateTime         @map("issue_date")
  expirationDate     DateTime         @map("expiration_date")
  status             CredentialStatus @default(active)
  verificationDate   DateTime?        @map("verification_date")
  verificationSource String?          @map("verification_source")
  notes              String?
  source             CredentialSource @default(manual_entry)

  // Audit
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdById String?  @map("created_by_id")
  updatedById String?  @map("updated_by_id")

  // Relations
  provider  Provider   @relation(fields: [providerId], references: [id], onDelete: Cascade)
  documents Document[]

  @@map("licenses")
}

enum BoardType {
  abpn_psychiatry
  abpn_child_adolescent
  abpn_addiction
  abpp_clinical
  abpp_counseling
  abecsw
  nbcc
  aamft
  ancc_pmhnp
  other
}

model BoardCertification {
  id         String @id @default(uuid())
  providerId String @map("provider_id")

  boardType                BoardType        @map("board_type")
  boardName                String           @map("board_name")
  certificationNumber      String?          @map("certification_number")
  specialty                String
  initialCertificationDate DateTime         @map("initial_certification_date")
  expirationDate           DateTime?        @map("expiration_date")
  status                   CredentialStatus @default(active)
  isBoardEligible          Boolean          @default(false) @map("is_board_eligible")
  notes                    String?
  source                   CredentialSource @default(manual_entry)

  // Audit
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdById String?  @map("created_by_id")
  updatedById String?  @map("updated_by_id")

  // Relations
  provider  Provider   @relation(fields: [providerId], references: [id], onDelete: Cascade)
  documents Document[]

  @@map("board_certifications")
}

enum CoverageType {
  occurrence
  claims_made
}

model MalpracticeInsurance {
  id         String @id @default(uuid())
  providerId String @map("provider_id")

  carrierName     String           @map("carrier_name")
  policyNumber    String           @map("policy_number")
  coverageType    CoverageType     @map("coverage_type")
  perClaimAmount  Decimal          @map("per_claim_amount") @db.Decimal(15, 2)
  aggregateAmount Decimal          @map("aggregate_amount") @db.Decimal(15, 2)
  effectiveDate   DateTime         @map("effective_date")
  expirationDate  DateTime         @map("expiration_date")
  hasTailCoverage Boolean          @default(false) @map("has_tail_coverage")
  status          CredentialStatus @default(active)
  notes           String?

  // Audit
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdById String?  @map("created_by_id")
  updatedById String?  @map("updated_by_id")

  // Relations
  provider  Provider   @relation(fields: [providerId], references: [id], onDelete: Cascade)
  documents Document[]

  @@map("malpractice_insurances")
}

enum DegreeType {
  md
  do
  phd
  psyd
  msw
  ma
  ms
  med
  dnp
  msn
  bs
  ba
  other
}

model Education {
  id         String @id @default(uuid())
  providerId String @map("provider_id")

  institutionName String     @map("institution_name")
  degree          DegreeType
  fieldOfStudy    String     @map("field_of_study")
  city            String?
  state           String?
  country         String     @default("US")
  startDate       DateTime   @map("start_date")
  endDate         DateTime?  @map("end_date")
  graduationDate  DateTime?  @map("graduation_date")
  isCompleted     Boolean    @default(true) @map("is_completed")
  notes           String?

  // Audit
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdById String?  @map("created_by_id")
  updatedById String?  @map("updated_by_id")

  // Relations
  provider  Provider   @relation(fields: [providerId], references: [id], onDelete: Cascade)
  documents Document[]

  @@map("educations")
}

model WorkHistory {
  id         String @id @default(uuid())
  providerId String @map("provider_id")

  organizationName String    @map("organization_name")
  organizationType String    @map("organization_type")
  position         String
  department       String?
  addressLine1     String?   @map("address_line_1")
  city             String?
  state            String?
  zipCode          String?   @map("zip_code")
  phone            String?
  startDate        DateTime  @map("start_date")
  endDate          DateTime? @map("end_date")
  isCurrent        Boolean   @default(false) @map("is_current")
  reasonForLeaving String?   @map("reason_for_leaving")
  supervisorName   String?   @map("supervisor_name")
  supervisorPhone  String?   @map("supervisor_phone")
  notes            String?

  // Audit
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdById String?  @map("created_by_id")
  updatedById String?  @map("updated_by_id")

  // Relations
  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@map("work_histories")
}

enum PrivilegeType {
  admitting
  courtesy
  consulting
  temporary
  locum_tenens
}

enum AffiliationStatus {
  active
  pending
  inactive
  denied
  resigned
}

model HospitalAffiliation {
  id         String @id @default(uuid())
  providerId String @map("provider_id")

  facilityName      String            @map("facility_name")
  facilityType      String            @map("facility_type")
  privilegeType     PrivilegeType     @map("privilege_type")
  status            AffiliationStatus
  appointmentDate   DateTime?         @map("appointment_date")
  reappointmentDate DateTime?         @map("reappointment_date")
  city              String?
  state             String?
  notes             String?

  // Audit
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdById String?  @map("created_by_id")
  updatedById String?  @map("updated_by_id")

  // Relations
  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@map("hospital_affiliations")
}

model ProfessionalReference {
  id         String @id @default(uuid())
  providerId String @map("provider_id")

  name         String
  title        String
  organization String
  relationship String
  email        String
  phone        String
  yearsKnown   Int     @map("years_known")
  canContact   Boolean @default(true) @map("can_contact")
  notes        String?

  // Audit
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdById String?  @map("created_by_id")
  updatedById String?  @map("updated_by_id")

  // Relations
  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@map("professional_references")
}

enum DisciplinaryActionType {
  license_action
  hospital_action
  malpractice_claim
  legal_action
  other
}

model DisciplinaryAction {
  id         String @id @default(uuid())
  providerId String @map("provider_id")

  actionType     DisciplinaryActionType @map("action_type")
  description    String
  dateOfAction   DateTime               @map("date_of_action")
  state          String?
  agency         String?
  outcome        String?
  isResolved     Boolean                @default(false) @map("is_resolved")
  resolutionDate DateTime?              @map("resolution_date")
  notes          String?

  // Audit
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdById String?  @map("created_by_id")
  updatedById String?  @map("updated_by_id")

  // Relations
  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@map("disciplinary_actions")
}

model ContinuingEducation {
  id         String @id @default(uuid())
  providerId String @map("provider_id")

  courseName        String   @map("course_name")
  courseProvider    String   @map("course_provider")
  credits           Decimal  @db.Decimal(5, 2)
  creditType        String   @map("credit_type")
  completionDate    DateTime @map("completion_date")
  certificateNumber String?  @map("certificate_number")
  notes             String?

  // Audit
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdById String?  @map("created_by_id")
  updatedById String?  @map("updated_by_id")

  // Relations
  provider  Provider   @relation(fields: [providerId], references: [id], onDelete: Cascade)
  documents Document[]

  @@map("continuing_educations")
}

// ==========================================
// DOCUMENTS
// ==========================================

enum DocumentType {
  license
  board_certification
  malpractice_certificate
  diploma
  transcript
  cv_resume
  photo
  government_id
  dea_certificate
  cds_certificate
  cme_certificate
  hospital_letter
  reference_letter
  w9
  coi
  cp575
  other
}

enum OcrStatus {
  pending
  processing
  completed
  failed
  not_applicable
}

model Document {
  id         String @id @default(uuid())
  providerId String @map("provider_id")

  // File info
  fileName         String @map("file_name")
  originalFileName String @map("original_file_name")
  fileSize         Int    @map("file_size")
  mimeType         String @map("mime_type")
  s3Key            String @map("s3_key")

  // Classification
  documentType DocumentType @map("document_type")
  description  String?

  // Linked credential
  linkedLicenseId              String?             @map("linked_license_id")
  linkedBoardCertificationId   String?             @map("linked_board_certification_id")
  linkedMalpracticeInsuranceId String?             @map("linked_malpractice_insurance_id")
  linkedEducationId            String?             @map("linked_education_id")
  linkedContinuingEducationId  String?             @map("linked_continuing_education_id")

  // Expiration
  expirationDate DateTime? @map("expiration_date")

  // OCR
  ocrStatus     OcrStatus @default(not_applicable) @map("ocr_status")
  ocrData       Json?     @map("ocr_data")
  ocrConfidence Float?    @map("ocr_confidence")
  ocrReviewedAt DateTime? @map("ocr_reviewed_at")
  ocrReviewedBy String?   @map("ocr_reviewed_by")

  // Verification
  isVerified Boolean   @default(false) @map("is_verified")
  verifiedAt DateTime? @map("verified_at")
  verifiedBy String?   @map("verified_by")

  // Portal upload review
  reviewStatus      String?   @default("pending") @map("review_status")
  reviewedById      String?   @map("reviewed_by_id")
  reviewedAt        DateTime? @map("reviewed_at")
  reviewNotes       String?   @map("review_notes")
  uploadedViaPortal Boolean   @default(false) @map("uploaded_via_portal")

  // Audit
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdById String?  @map("created_by_id")

  // Relations
  provider               Provider               @relation(fields: [providerId], references: [id], onDelete: Cascade)
  license                License?               @relation(fields: [linkedLicenseId], references: [id])
  boardCertification     BoardCertification?    @relation(fields: [linkedBoardCertificationId], references: [id])
  malpracticeInsurance   MalpracticeInsurance?  @relation(fields: [linkedMalpracticeInsuranceId], references: [id])
  education              Education?             @relation(fields: [linkedEducationId], references: [id])
  continuingEducation    ContinuingEducation?   @relation(fields: [linkedContinuingEducationId], references: [id])
  createdBy              User?                  @relation("DocumentCreatedBy", fields: [createdById], references: [id])
  ocrReviewer            User?                  @relation("DocumentReviewedBy", fields: [ocrReviewedBy], references: [id])
  documentReviewer       User?                  @relation("DocumentReviewer", fields: [reviewedById], references: [id])

  @@map("documents")
}

// ==========================================
// PROVIDER CHECKLIST
// ==========================================

enum ChecklistItemStatus {
  not_started
  pending_upload
  pending_review
  approved
  rejected
}

model ProviderChecklist {
  id         String @id @default(uuid())
  providerId String @unique @map("provider_id")

  // Required Documents Status
  w9Status          ChecklistItemStatus @default(not_started) @map("w9_status")
  w9DocumentId      String?             @map("w9_document_id")
  w9ReviewedAt      DateTime?           @map("w9_reviewed_at")
  w9ReviewedBy      String?             @map("w9_reviewed_by")
  w9Notes           String?             @map("w9_notes")

  coiStatus         ChecklistItemStatus @default(not_started) @map("coi_status")
  coiDocumentId     String?             @map("coi_document_id")
  coiReviewedAt     DateTime?           @map("coi_reviewed_at")
  coiReviewedBy     String?             @map("coi_reviewed_by")
  coiNotes          String?             @map("coi_notes")

  cp575Status       ChecklistItemStatus @default(not_started) @map("cp575_status")
  cp575DocumentId   String?             @map("cp575_document_id")
  cp575ReviewedAt   DateTime?           @map("cp575_reviewed_at")
  cp575ReviewedBy   String?             @map("cp575_reviewed_by")
  cp575Notes        String?             @map("cp575_notes")

  // Additional checklist items can be added here
  licenseVerified        Boolean @default(false) @map("license_verified")
  credentialsComplete    Boolean @default(false) @map("credentials_complete")
  backgroundCheckComplete Boolean @default(false) @map("background_check_complete")

  // Overall Status
  overallComplete   Boolean @default(false) @map("overall_complete")
  completedAt       DateTime? @map("completed_at")

  // Audit
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@map("provider_checklists")
}

// ==========================================
// PAYER ENROLLMENTS
// ==========================================

model Payer {
  id String @id @default(uuid())

  name        String
  payerId     String  @unique @map("payer_id")
  payerType   String  @map("payer_type")
  addressLine1 String? @map("address_line_1")
  city        String?
  state       String?
  zipCode     String? @map("zip_code")
  phone       String?
  website     String?
  notes       String?
  workflowKey String?  @map("workflow_key")

  // Audit
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  enrollments          PayerEnrollment[]
  directorySnapshots   ProviderDirectorySnapshot[]
  directoryAlerts      ProviderDirectoryAlert[]

  @@map("payers")
}

enum EnrollmentStatus {
  not_started
  in_progress
  submitted
  pending_review
  approved
  denied
  terminated
}

model PayerEnrollment {
  id         String @id @default(uuid())
  providerId String @map("provider_id")
  payerId    String @map("payer_id")

  status                 EnrollmentStatus @default(not_started)
  productTypes           String[]         @default([]) @map("product_types")
  applicationDate        DateTime?        @map("application_date")
  effectiveDate          DateTime?        @map("effective_date")
  terminationDate        DateTime?        @map("termination_date")
  dateContractReceived   DateTime?        @map("date_contract_received")
  dateContractSigned     DateTime?        @map("date_contract_signed")
  lastFollowUpDate       DateTime?        @map("last_follow_up_date")
  recredentialingDate    DateTime?        @map("recredentialing_date")
  providerNumber         String?          @map("provider_number")
  groupNumber            String?          @map("group_number")
  notes                  String?
  payerEmail             String?          @map("payer_email")

  // Automated Follow-up Settings
  followUpEnabled        Boolean   @default(false) @map("follow_up_enabled")
  followUpEmail          String?   @map("follow_up_email")
  followUpFrequencyDays  Int       @default(14) @map("follow_up_frequency_days")
  lastFollowUpSentAt     DateTime? @map("last_follow_up_sent_at")
  nextFollowUpDate       DateTime? @map("next_follow_up_date")

  // PDM Attestation Tracking (CAA 2021 - 90 day requirement)
  pdmLastAttestedAt      DateTime? @map("pdm_last_attested_at")
  pdmLastAttestedBy      String?   @map("pdm_last_attested_by")
  pdmEnabled             Boolean   @default(true) @map("pdm_enabled")

  // Workflow
  workflowType      WorkflowType?          @map("workflow_type")

  // Audit
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdById String?  @map("created_by_id")
  updatedById String?  @map("updated_by_id")

  // Relations
  provider          Provider           @relation(fields: [providerId], references: [id], onDelete: Cascade)
  payer             Payer              @relation(fields: [payerId], references: [id])
  aiRecommendations AiRecommendation[]
  tasks             Task[]
  workflowSteps     EnrollmentWorkflowStep[]

  @@unique([providerId, payerId])
  @@map("payer_enrollments")
}

// ==========================================
// AI RECOMMENDATIONS
// ==========================================

enum AiRecommendationType {
  follow_up_email
  strategy
  priority_alert
  payer_intelligence
}

enum AiRecommendationStatus {
  pending
  accepted
  dismissed
  expired
}

model AiRecommendation {
  id               String                 @id @default(uuid())
  enrollmentId     String?                @map("enrollment_id")
  providerId       String?                @map("provider_id")
  type             AiRecommendationType
  status           AiRecommendationStatus @default(pending)
  title            String
  content          String
  reasoning        String?
  metadata         Json?
  promptTokens     Int                    @default(0) @map("prompt_tokens")
  completionTokens Int                    @default(0) @map("completion_tokens")
  modelUsed        String?                @map("model_used")
  actedOnBy        String?                @map("acted_on_by")
  actedOnAt        DateTime?              @map("acted_on_at")
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")

  enrollment PayerEnrollment? @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  provider   Provider?        @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([enrollmentId])
  @@index([providerId])
  @@index([type])
  @@index([status])
  @@map("ai_recommendations")
}

// ==========================================
// AI CHAT
// ==========================================

model ChatConversation {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  title     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  messages  ChatMessage[]

  @@index([userId])
  @@map("chat_conversations")
}

model ChatMessage {
  id               String   @id @default(uuid())
  conversationId   String   @map("conversation_id")
  role             String   // 'user' | 'assistant'
  content          String   @db.Text
  metadata         Json?
  promptTokens     Int      @default(0) @map("prompt_tokens")
  completionTokens Int      @default(0) @map("completion_tokens")
  createdAt        DateTime @default(now()) @map("created_at")

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("chat_messages")
}

// ==========================================
// AUDIT LOGGING (SOC 2)
// ==========================================

enum AuditAction {
  create
  read
  update
  delete
  login
  logout
  export
  import
}

model AuditLog {
  id String @id @default(uuid())

  userId       String?     @map("user_id")
  action       AuditAction
  resourceType String      @map("resource_type")
  resourceId   String?     @map("resource_id")
  changes      Json?
  ipAddress    String?     @map("ip_address")
  userAgent    String?     @map("user_agent")
  timestamp    DateTime    @default(now())

  // Relations
  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([resourceType])
  @@index([timestamp])
  @@map("audit_logs")
}

// ==========================================
// CAQH SYNC HISTORY
// ==========================================

enum CaqhSyncStatus {
  pending
  in_progress
  completed
  failed
}

enum CaqhSyncDirection {
  pull
  push
}

model CaqhSyncLog {
  id         String @id @default(uuid())
  providerId String @map("provider_id")

  direction    CaqhSyncDirection
  status       CaqhSyncStatus
  startedAt    DateTime          @default(now()) @map("started_at")
  completedAt  DateTime?         @map("completed_at")
  errorMessage String?           @map("error_message")
  changesApplied Json?           @map("changes_applied")

  @@index([providerId])
  @@map("caqh_sync_logs")
}

// ==========================================
// NOTIFICATION TRACKING
// ==========================================

enum NotificationType {
  expiration_reminder
  enrollment_status
  enrollment_follow_up
  document_uploaded
  verification_complete
  application_submitted
  application_approved
}

enum NotificationStatus {
  pending
  sent
  failed
}

model Notification {
  id String @id @default(uuid())

  recipientEmail String           @map("recipient_email")
  type           NotificationType
  subject        String
  body           String
  status         NotificationStatus @default(pending)
  sentAt         DateTime?          @map("sent_at")
  errorMessage   String?            @map("error_message")
  metadata       Json?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([status])
  @@index([type])
  @@map("notifications")
}

// ==========================================
// ROSTER REPORT TEMPLATES
// ==========================================

model RosterTemplate {
  id          String   @id @default(uuid())
  name        String
  description String?
  columns     Json     // [{ fieldKey, label, width? }]
  filters     Json?
  sortConfig  Json?    @map("sort_config")
  isShared    Boolean  @default(false) @map("is_shared")
  createdById String   @map("created_by_id")
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("roster_templates")
}

// ==========================================
// PROVIDER PORTAL / SELF-REGISTRATION
// ==========================================

enum ApplicationStatus {
  pending
  approved
  rejected
}

model ProviderApplication {
  id     String            @id @default(uuid())
  status ApplicationStatus @default(pending)

  // Provider Info
  npi        String
  firstName  String @map("first_name")
  lastName   String @map("last_name")
  middleName String? @map("middle_name")
  suffix     String?
  email      String
  phone      String

  // Personal Info
  dateOfBirth DateTime  @map("date_of_birth")
  gender      Gender

  // Professional Info
  providerType String?  @map("provider_type")
  taxonomy     String?
  specialties  String[]

  // Tracking
  submittedAt DateTime  @default(now()) @map("submitted_at")
  reviewedAt  DateTime? @map("reviewed_at")
  reviewedBy  String?   @map("reviewed_by")
  reviewNotes String?   @map("review_notes")

  // Auto-assign to practice (from registration link)
  practiceId  String?   @map("practice_id")
  practice    Practice? @relation(fields: [practiceId], references: [id])

  // Re-application support
  previousApplicationId String?              @unique @map("previous_application_id")
  previousApplication   ProviderApplication? @relation("ReApplication", fields: [previousApplicationId], references: [id])
  reApplication         ProviderApplication? @relation("ReApplication")

  // Link to created provider (after approval)
  providerId String?   @map("provider_id")
  provider   Provider? @relation(fields: [providerId], references: [id])

  @@index([status])
  @@index([npi])
  @@map("provider_applications")
}

model AdminNotification {
  id            String   @id @default(uuid())
  type          String   // 'NEW_APPLICATION'
  message       String
  read          Boolean  @default(false)
  applicationId String?  @map("application_id")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([read])
  @@map("admin_notifications")
}

// ==========================================
// IN-APP NOTIFICATIONS
// ==========================================

enum InAppNotificationType {
  new_application
  application_updated
  credential_expiring
  credential_expired
  document_uploaded
  document_verified
  application_approved
  application_rejected
  enrollment_status_change
  system_announcement
}

model InAppNotification {
  id        String               @id @default(uuid())
  userId    String               @map("user_id")
  type      InAppNotificationType
  title     String
  message   String
  read      Boolean              @default(false)
  actionUrl String?              @map("action_url")
  metadata  Json?
  createdAt DateTime             @default(now()) @map("created_at")
  readAt    DateTime?            @map("read_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([userId, createdAt])
  @@map("in_app_notifications")
}

// ==========================================
// TERMINATION WORKFLOW
// ==========================================

enum TaskType {
  TERMINATE_ENROLLMENT
  CHECK_AVAILITY
  UPDATE_CAQH
  DRAFT_TERM_LETTER
  CUSTOM
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

enum TerminationLetterStatus {
  DRAFT
  REVIEWED
  SENT
}

model Task {
  id            String     @id @default(uuid())
  providerId    String     @map("provider_id")
  enrollmentId  String?    @map("enrollment_id")
  title         String
  description   String?
  type          TaskType
  status        TaskStatus @default(PENDING)
  assignedToId  String?    @map("assigned_to_id")
  dueDate       DateTime?  @map("due_date")
  completedAt   DateTime?  @map("completed_at")
  completedById String?    @map("completed_by_id")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  provider    Provider         @relation(fields: [providerId], references: [id], onDelete: Cascade)
  enrollment  PayerEnrollment? @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)
  assignedTo  User?            @relation("TaskAssignedTo", fields: [assignedToId], references: [id])
  completedBy User?            @relation("TaskCompletedBy", fields: [completedById], references: [id])
  terminationLetters TerminationLetter[]

  @@index([providerId])
  @@index([enrollmentId])
  @@index([status])
  @@index([type])
  @@map("tasks")
}

model TerminationLetter {
  id            String                  @id @default(uuid())
  providerId    String                  @map("provider_id")
  taskId        String                  @map("task_id")
  payerName     String                  @map("payer_name")
  payerEmail    String?                 @map("payer_email")
  providerName  String                  @map("provider_name")
  npi           String
  groupNpi      String?                 @map("group_npi")
  taxId         String                  @map("tax_id")
  letterContent String                  @map("letter_content") @db.Text
  status        TerminationLetterStatus @default(DRAFT)
  reviewedById  String?                 @map("reviewed_by_id")
  reviewedAt    DateTime?               @map("reviewed_at")
  sentAt        DateTime?               @map("sent_at")
  createdAt     DateTime                @default(now()) @map("created_at")
  updatedAt     DateTime                @updatedAt @map("updated_at")

  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  reviewedBy User?    @relation("TermLetterReviewedBy", fields: [reviewedById], references: [id])

  @@index([providerId])
  @@index([taskId])
  @@map("termination_letters")
}

// ==========================================
// PROVIDER DIRECTORY VERIFICATION
// ==========================================

enum DirectoryListingStatus {
  listed
  not_found
  mismatch
  error
}

model ProviderDirectorySnapshot {
  id         String                 @id @default(uuid())
  providerId String                 @map("provider_id")
  payerId    String                 @map("payer_id")

  status       DirectoryListingStatus
  checkedAt    DateTime               @default(now()) @map("checked_at")
  fhirResponse Json?                  @map("fhir_response")

  // Parsed fields from FHIR Practitioner resource
  listedName       String?  @map("listed_name")
  listedNpi        String?  @map("listed_npi")
  listedPhone      String?  @map("listed_phone")
  listedSpecialty  String?  @map("listed_specialty")
  listedAddress    String?  @map("listed_address")
  networkNames     String[] @default([]) @map("network_names")

  // Mismatch details (JSON array of { field, ours, theirs })
  mismatches Json? @map("mismatches")

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  payer    Payer    @relation(fields: [payerId], references: [id])
  alerts   ProviderDirectoryAlert[]

  @@index([providerId, payerId])
  @@index([checkedAt])
  @@map("provider_directory_snapshots")
}

model ProviderDirectoryAlert {
  id         String @id @default(uuid())
  providerId String @map("provider_id")
  payerId    String @map("payer_id")
  snapshotId String @map("snapshot_id")

  alertType   String
  message     String
  details     Json?
  resolved    Boolean   @default(false)
  resolvedAt  DateTime? @map("resolved_at")
  resolvedBy  String?   @map("resolved_by")
  createdAt   DateTime  @default(now()) @map("created_at")

  provider Provider                  @relation(fields: [providerId], references: [id], onDelete: Cascade)
  payer    Payer                     @relation(fields: [payerId], references: [id])
  snapshot ProviderDirectorySnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@index([providerId])
  @@index([resolved])
  @@map("provider_directory_alerts")
}

// ==========================================
// ENROLLMENT WORKFLOW STEPS
// ==========================================

model EnrollmentWorkflowStep {
  id             String @id @default(uuid())
  enrollmentId   String @map("enrollment_id")

  // Template reference
  templateStepId String @map("template_step_id")
  stepOrder      Int    @map("step_order")

  // Step details (copied from template at creation time)
  name           String
  description    String   @db.Text
  actionType     WorkflowActionType @map("action_type")
  url            String?
  owner          WorkflowStepOwner
  estimatedDays  Int      @map("estimated_days")

  // Dependencies & requirements
  dependencies   String[] @default([])
  documentsNeeded String[] @default([])  @map("documents_needed")
  warnings       String[] @default([])

  // Progress tracking
  status         WorkflowStepStatus @default(not_started)
  startedAt      DateTime?  @map("started_at")
  completedAt    DateTime?  @map("completed_at")
  completedById  String?    @map("completed_by_id")
  skippedReason  String?    @map("skipped_reason")
  notes          String?

  // Audit
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  enrollment  PayerEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  completedBy User?           @relation("WorkflowStepCompletedBy", fields: [completedById], references: [id])

  @@index([enrollmentId])
  @@index([status])
  @@index([enrollmentId, stepOrder])
  @@map("enrollment_workflow_steps")
}
