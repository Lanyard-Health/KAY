  description     String
  appliesTo       String  @map("applies_to")
  isBlocking      Boolean @map("is_blocking")
  standardMinimum String? @map("standard_minimum")
  notes           String?

  embeddings      KnowledgeBaseEmbedding[]

  createdAt       DateTime @default(now()) @map("created_at")

  @@map("requirement_universals")
}

model PayerRequirement {
  id            String    @id @default(cuid())
  payerTrackId  String    @map("payer_track_id")
  payerTrack    PayerTrack @relation(fields: [payerTrackId], references: [id], onDelete: Cascade)
  name          String
  overrideType  String    @map("override_type") // ADDITIONAL | STRICTER | ALTERNATE_PROCESS | EXCEPTION | STATE_MINIMUM
  rule          String
  appliesTo     String?   @map("applies_to")
  isBlocking    Boolean   @map("is_blocking")
  source        String?
  createdAt     DateTime  @default(now()) @map("created_at")

  embeddings    KnowledgeBaseEmbedding[]

  @@map("payer_requirements")
}

// ==========================================
// KNOWLEDGE BASE — EMBEDDINGS
// ==========================================

model KnowledgeBaseEmbedding {
  id                     String  @id @default(cuid())
  // Source — one of these will be set
  payerTrackId           String? @map("payer_track_id")
  payerRequirementId     String? @map("payer_requirement_id")
  payerStateRuleId       String? @map("payer_state_rule_id")
  payerTimelineId        String? @map("payer_timeline_id")
  payerFormId            String? @map("payer_form_id")
  requirementUniversalId String? @map("requirement_universal_id")
  // Content
  contentText            String  @map("content_text") // text that was embedded — stored for debugging
  embedding              Unsupported("vector(1536)")
  modelUsed              String  @map("model_used")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  // Relations
  payerTrack             PayerTrack?           @relation(fields: [payerTrackId], references: [id], onDelete: Cascade)
  payerRequirement       PayerRequirement?     @relation(fields: [payerRequirementId], references: [id], onDelete: Cascade)
  payerStateRule         PayerStateRule?        @relation(fields: [payerStateRuleId], references: [id], onDelete: Cascade)
  payerTimeline          PayerTimeline?         @relation(fields: [payerTimelineId], references: [id], onDelete: Cascade)
  payerForm              PayerForm?             @relation(fields: [payerFormId], references: [id], onDelete: Cascade)
  requirementUniversal   RequirementUniversal?  @relation(fields: [requirementUniversalId], references: [id], onDelete: Cascade)

  @@index([payerTrackId])
  @@index([payerRequirementId])
  @@map("knowledge_base_embeddings")
}

// ==========================================
// WORKFLOW TEMPLATES
// ==========================================

model WorkflowTemplate {
  id            String    @id @default(cuid())
  payerTrackId  String    @map("payer_track_id")
  payerTrack    PayerTrack @relation(fields: [payerTrackId], references: [id])
  name          String
  version       Int       @default(1)
  status        String    // draft | active | archived
  description   String?
  createdBy     String    @map("created_by") // User ID — must be admin
  publishedAt   DateTime? @map("published_at")

  steps         WorkflowTemplateStep[]
  conditions    WorkflowTemplateCondition[]
  enrollments   Enrollment[]

  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@map("workflow_templates")
}

model WorkflowTemplateStep {
  id                   String            @id @default(cuid())
  templateId           String            @map("template_id")
  template             WorkflowTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  stepOrder            Int               @map("step_order")
  name                 String
  description          String?
  stepType             String            @map("step_type") // readiness_check | caqh_authorization | populate_template | human_review | submit_application | confirm_submission | follow_up | escalate | await_decision | record_outcome
  owner                String            // credentialing_staff | provider | payer
  requiredDocuments    String[]          @default([]) @map("required_documents")
  triggerDaysAfterPrev Int?              @map("trigger_days_after_prev")
  isBlocking           Boolean           @default(true) @map("is_blocking")
  reviewerInstructions String?           @map("reviewer_instructions")
  createdAt            DateTime          @default(now()) @map("created_at")

  @@map("workflow_template_steps")
}

model WorkflowTemplateCondition {
  id              String            @id @default(cuid())
  templateId      String            @map("template_id")
  template        WorkflowTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  conditionType   String            @map("condition_type") // state | provider_type | has_dea | has_hospital_privileges
  conditionValue  String            @map("condition_value")
  action          String            // add_step | skip_step | modify_step
  targetStepOrder Int?              @map("target_step_order")
  stepDefinition  Json?             @map("step_definition")
  createdAt       DateTime          @default(now()) @map("created_at")

  @@map("workflow_template_conditions")
}

// ==========================================
// FOLLOW-UP TEMPLATES
// ==========================================

model FollowUpTemplate {
  id            String    @id @default(cuid())
  payerTrackId  String    @map("payer_track_id")
  payerTrack    PayerTrack @relation(fields: [payerTrackId], references: [id])
  name          String
  version       Int       @default(1)
  status        String    // draft | active | archived
  description   String?
  createdBy     String    @map("created_by") // User ID — must be admin
  publishedAt   DateTime? @map("published_at")

  steps         FollowUpTemplateStep[]
  runs          FollowUpRun[]

  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@map("follow_up_templates")
}

model FollowUpTemplateStep {
  id                   String            @id @default(cuid())
  templateId           String            @map("template_id")
  template             FollowUpTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  stepOrder            Int               @map("step_order")
  name                 String
  channel              String            // email | phone_call
  triggerDaysAfterPrev Int               @map("trigger_days_after_prev")
  escalationLevel      Int               @default(1) @map("escalation_level")
  // Email (SES)
  emailSubject         String?           @map("email_subject")
  emailBodyTemplate    String?           @map("email_body_template")
  emailTone            String?           @map("email_tone") // professional | urgent | escalated
  // Phone call (Retell AI)
  retellScriptTemplate String?           @map("retell_script_template")
  retellAgentId        String?           @map("retell_agent_id")
  requiresApproval     Boolean           @default(true) @map("requires_approval")
  createdAt            DateTime          @default(now()) @map("created_at")

  @@map("follow_up_template_steps")
}

// ==========================================
// FOLLOW-UP RUNS
// ==========================================

model FollowUpRun {
  id                String            @id @default(cuid())
  enrollmentId      String            @map("enrollment_id")
  enrollment        Enrollment        @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  templateId        String            @map("template_id")
  template          FollowUpTemplate  @relation(fields: [templateId], references: [id])
  status            String            // active | paused | completed | cancelled
  currentStepOrder  Int               @default(1) @map("current_step_order")
  startedAt         DateTime          @default(now()) @map("started_at")
  completedAt       DateTime?         @map("completed_at")
  lastExecutedAt    DateTime?         @map("last_executed_at")

  callLogs          RetellCallLog[]
  approvals         PendingApproval[]

  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  @@index([status])
  @@map("follow_up_runs")
}

model RetellCallLog {
  id                String        @id @default(cuid())
  followUpRunId     String        @map("follow_up_run_id")
  followUpRun       FollowUpRun   @relation(fields: [followUpRunId], references: [id], onDelete: Cascade)
  retellCallId      String        @map("retell_call_id")
  payerContactId    String?       @map("payer_contact_id")
  phoneNumber       String        @map("phone_number")
  status            String        // completed | failed | no_answer | voicemail
  outcome           String?
  transcript        String?
  durationSeconds   Int?          @map("duration_seconds")
  calledAt          DateTime      @map("called_at")
  createdAt         DateTime      @default(now()) @map("created_at")

  @@map("retell_call_logs")
}

// ==========================================
// DENIAL TRIAGE
// ==========================================

model DenialTriage {
  id                String     @id @default(cuid())
  enrollmentId      String     @map("enrollment_id")
  enrollment        Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  denialReason      String     @map("denial_reason")
  denialDate        DateTime   @map("denial_date")
  triageReport      String?    @map("triage_report")
  identifiedGaps    Json?      @map("identified_gaps")
  appealDeadline    DateTime?  @map("appeal_deadline")
  recommendedAction String?    @map("recommended_action") // appeal | reapply | abandon | needs_review
  recommendedSteps  Json?      @map("recommended_steps")
  status            String     // pending | reviewed | actioned
  reviewedBy        String     @map("reviewed_by")
  reviewedAt        DateTime?  @map("reviewed_at")
  reviewNotes       String?    @map("review_notes")
  promptTokens      Int?       @map("prompt_tokens")
  completionTokens  Int?       @map("completion_tokens")
  modelUsed         String?    @map("model_used")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")

  @@map("denial_triages")
}
