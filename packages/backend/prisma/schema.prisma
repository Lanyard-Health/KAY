// ==========================================
// EMAIL TEMPLATES & LOGS
// ==========================================

enum EmailTemplateType {
  AUTOMATED_ONBOARDING
  STATIC_ON_DEMAND
}

enum EmailSendStatus {
  PENDING
  SENT
  FAILED
}

model EmailTemplate {
  id           String            @id @default(uuid())
  name         String
  subject      String
  body         String
  type         EmailTemplateType
  triggerEvent String?           @map("trigger_event")
  isActive     Boolean           @default(true) @map("is_active")
  createdBy    String            @map("created_by")
  createdByUser User             @relation("EmailTemplateCreator", fields: [createdBy], references: [id])
  updatedAt    DateTime          @updatedAt @map("updated_at")
  createdAt    DateTime          @default(now()) @map("created_at")

  emailLogs EmailLog[]

  @@map("email_templates")
}

model EmailLog {
  id           String          @id @default(uuid())
  templateId   String?         @map("template_id")
  template     EmailTemplate?  @relation(fields: [templateId], references: [id])
  practiceId   String?         @map("practice_id")
  practice     Practice?       @relation(fields: [practiceId], references: [id])
  to           String
  subject      String
  status       EmailSendStatus @default(PENDING)
  resendId     String?         @map("resend_id")
  errorMessage String?         @map("error_message")
  sentAt       DateTime?       @map("sent_at")
  createdAt    DateTime        @default(now()) @map("created_at")

  @@index([templateId])
  @@index([practiceId])
  @@map("email_logs")
}

// =====================
// Submission Engine — Phase 1
// =====================

// AdapterType — which adapter handles a given payer's portal/API submission.
// Phase 1 registers CAQH + MANUAL only. PLAYWRIGHT_GENERIC, AETNA_BH, AVAILITY
// are placeholders for next-quarter payer adapters. FAX is schema-ready for Phase 4.
enum AdapterType {
  CAQH
  PLAYWRIGHT_GENERIC
  AETNA_BH
  AVAILITY
  MANUAL
  FAX
}

// SubmissionMethod — coarse-grained channel category. Independent of AdapterType
// because one method can have multiple adapter implementations (e.g., AETNA_BH and
// AVAILITY both use WEB_PORTAL).
enum SubmissionMethod {
  WEB_PORTAL
  API
  FAX
  EMAIL
  MANUAL
}

// DeliveryEngine — set on PayerForm. Drives channel dispatch: BROWSER → submission
// queue (Playwright bot); FAX → agent-fax queue (Phaxio); EMAIL/MANUAL → coordinator
// hand-off paths. Nullable on PayerForm because many seeded forms have no automation
// configured yet.
enum DeliveryEngine {
  BROWSER
  FAX
  EMAIL
  MANUAL
}

// PayerFormFormat — visual/structural classification of a payer's enrollment form.
// Drives form-fill engine selection. Distinct from DeliveryEngine: a PDF form can
// be delivered via FAX or EMAIL; an ONLINE form is BROWSER-delivered.
enum PayerFormFormat {
  ONLINE
  PDF
  PORTAL
}

// EnrollmentRunStatus — replaces the unconstrained String status on EnrollmentRun.
// Terminal states (APPROVED, DENIED, FAILED, CANCELLED) are guarded by
// validateRunStatusTransition() in enrollment.service.ts.
enum EnrollmentRunStatus {
  PENDING          // created, not yet queued
  QUEUED           // job enqueued in BullMQ
  FILLING          // adapter is filling the form
  AWAITING_REVIEW  // needs coordinator approval before submit
  SUBMITTING       // adapter has clicked submit
  SUBMITTED        // payer portal confirmed receipt
  ACKNOWLEDGED     // payer confirmed processing (if async)
  APPROVED         // payer approved enrollment
  DENIED           // payer denied enrollment
  FAILED           // all retry attempts exhausted
  CANCELLED        // coordinator cancelled before execution
  NEEDS_REVIEW     // adapter completed but confirmation ambiguous — human check required
}

// PortalCredentialType — disambiguates credential ownership. CAQH and some payer
// portals issue per-provider logins (INDIVIDUAL). Availity / MCO portals issue
// per-practice logins (GROUP). resolveCredential() in credential.service.ts
// dispatches lookup based on this value on the parent Payer.
enum PortalCredentialType {
  GROUP       // practice owns this login
  INDIVIDUAL  // provider owns this login
}

// SubmissionJobStatus — lifecycle of a BullMQ submission job record.
enum SubmissionJobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  DEAD_LETTERED
}

// FaxJobStatus — lifecycle of a fax channel run.
enum FaxJobStatus {
  PENDING        // created, not yet dispatched
  SENDING        // dispatched to vendor, awaiting delivery
  SENT           // vendor confirmed delivery via webhook
  FAILED         // one attempt failed, will retry
  DEAD_LETTERED  // all attempts exhausted
}

// PortalCredential — per-tenant credential vault for payer portal logins.
// Replaces PayerSubmissionConfig.credentialsEncrypted (the cross-tenant leak fix).
// Encrypted payload uses encryptForTenant(practiceId, ...) — HKDF-derived key per
// practice. Exactly one of practiceId or providerId is set, governed by credentialType.
model PortalCredential {
  id      String @id @default(cuid())
  payerId String @map("payer_id")
  payer   Payer  @relation(fields: [payerId], references: [id])

  // Credential ownership — exactly one of these must be set
  practiceId String?          @map("practice_id")  // GROUP credentials
  practice   Practice?        @relation(fields: [practiceId], references: [id])
  providerId String?          @map("provider_id")  // INDIVIDUAL credentials
  provider   ProviderProfile? @relation(fields: [providerId], references: [id])

  // Encrypted payload — encryptForTenant(practiceId, plaintext)
  usernameEncrypted    String  @map("username_encrypted")
  passwordEncrypted    String  @map("password_encrypted")
  mfaSeedEncrypted     String? @map("mfa_seed_encrypted")     // TOTP seed if payer requires MFA
  extraConfigEncrypted String? @map("extra_config_encrypted") // security questions, PIN, etc.

  credentialType PortalCredentialType @map("credential_type")

  lastVerifiedAt DateTime? @map("last_verified_at")
  lastUsedAt     DateTime? @map("last_used_at")
  isActive       Boolean   @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([payerId, practiceId])   // one GROUP cred per (payer, practice)
  @@unique([payerId, providerId])   // one INDIVIDUAL cred per (payer, provider)
  @@index([practiceId])
  @@index([providerId])
  @@map("portal_credentials")
}

// SubmissionJob — BullMQ job record. One-to-one with EnrollmentRun. bullmqJobId
// equals enrollmentRunId for deduplication. Captures submission artifacts
// (screenshots, confirmation number) for audit/SOC 2 evidence.
model SubmissionJob {
  id              String        @id @default(cuid())
  enrollmentRunId String        @unique @map("enrollment_run_id")
  enrollmentRun   EnrollmentRun @relation(fields: [enrollmentRunId], references: [id])

  bullmqJobId  String              @unique @map("bullmq_job_id")  // = enrollmentRunId
  status       SubmissionJobStatus
  attemptCount Int                 @default(0) @map("attempt_count")
  maxAttempts  Int                 @default(3) @map("max_attempts")

  lastError     String?   @map("last_error")
  lastAttemptAt DateTime? @map("last_attempt_at")
  completedAt   DateTime? @map("completed_at")

  // Submission artifacts
  confirmationNumber String? @map("confirmation_number")
  preScreenshotKey   String? @map("pre_screenshot_key")   // S3 key
  postScreenshotKey  String? @map("post_screenshot_key")  // S3 key
  rawResponseText    String? @map("raw_response_text")

  // Relations
  faxJobs FaxJob[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([enrollmentRunId])
  @@map("submission_jobs")
}

// FaxJob — Phase 4 channel run record. Schema-ready in Phase 1 so EnrollmentRun
// and SubmissionJob can declare their relations now. Phaxio is the default vendor.
model FaxJob {
  id String @id @default(cuid())

  // Parent submission context
  submissionJobId String?        @map("submission_job_id")
  submissionJob   SubmissionJob? @relation(fields: [submissionJobId], references: [id])
  enrollmentRunId String         @map("enrollment_run_id")
  enrollmentRun   EnrollmentRun  @relation(fields: [enrollmentRunId], references: [id])
  practiceId      String         @map("practice_id")
  payerId         String         @map("payer_id")

  // Fax destination
  toFaxNumber String @map("to_fax_number")

  // Content references (S3 keys)
  filledPdfKey  String  @map("filled_pdf_key")
  coverSheetKey String? @map("cover_sheet_key")

  // Vendor tracking
  vendor      String           // 'phaxio' — or future vendor if swapped
  vendorFaxId String?          @map("vendor_fax_id")

  // Lifecycle
  status        FaxJobStatus @default(PENDING)
  attemptCount  Int          @default(0) @map("attempt_count")
  maxAttempts   Int          @default(5) @map("max_attempts")
  lastAttemptAt DateTime?    @map("last_attempt_at")
  confirmedAt   DateTime?    @map("confirmed_at")
  failedAt      DateTime?    @map("failed_at")
  failureReason String?      @map("failure_reason")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([enrollmentRunId])
  @@index([status])
  @@index([practiceId])
  @@map("fax_jobs")
}

