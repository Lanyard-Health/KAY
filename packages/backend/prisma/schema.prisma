// Healthcare Credentialing Database Schema
// PostgreSQL database with full audit trail for SOC 2 compliance

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// USER MANAGEMENT
// ==========================================

enum UserRole {
  admin
  credentialing_staff
  provider
  practice_admin
}

enum PracticeStatus {
  ACTIVE
  INACTIVE
}

enum PracticeRole {
  SUPER_ADMIN
  PRACTICE_ADMIN
  PRACTICE_STAFF
  PROVIDER
}

enum EnterpriseQueueStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum SubscriptionPlan {
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  PAUSED
}

model User {
  id          String    @id @default(uuid())
  cognitoId   String    @unique @map("cognito_id")
  email       String    @unique
  firstName   String    @map("first_name")
  lastName    String    @map("last_name")
  phone       String?
  role        UserRole
  isActive    Boolean   @default(true) @map("is_active")
  lastLoginAt DateTime? @map("last_login_at")

  // Link to provider if role is 'provider'
  providerId String?          @unique @map("provider_id")
  provider   ProviderProfile? @relation(fields: [providerId], references: [id])

  // Audit
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  auditLogs                   AuditLog[]
  documentsCreated            Document[]               @relation("DocumentCreatedBy")
  documentsReviewed           Document[]               @relation("DocumentReviewedBy")
  documentsReviewedAsReviewer Document[]               @relation("DocumentReviewer")
  tasksAssigned               Task[]                   @relation("TaskAssignedTo")
  tasksCompleted              Task[]                   @relation("TaskCompletedBy")
  termLettersReviewed         TerminationLetter[]      @relation("TermLetterReviewedBy")
  practices                   UserPractice[]
  inAppNotifications          InAppNotification[]
  workflowStepsCompleted      EnrollmentWorkflowStep[] @relation("WorkflowStepCompletedBy")
  aetnaEnrollmentRuns         AetnaEnrollmentRun[]
  requestedWorkflows          AgentWorkflow[]          @relation("WorkflowRequester")
  approvalDecisions           PendingApproval[]        @relation("ApprovalDecider")

  // Audit trail back-references (createdBy / updatedBy)
  providersCreated            ProviderProfile[]       @relation("ProviderCreatedBy")
  providersUpdated            ProviderProfile[]       @relation("ProviderUpdatedBy")
  practiceLocationsCreated    PracticeLocation[]      @relation("PracticeLocationCreatedBy")
  practiceLocationsUpdated    PracticeLocation[]      @relation("PracticeLocationUpdatedBy")
  licensesCreated             License[]               @relation("LicenseCreatedBy")
  licensesUpdated             License[]               @relation("LicenseUpdatedBy")
  boardCertsCreated           BoardCertification[]    @relation("BoardCertCreatedBy")
  boardCertsUpdated           BoardCertification[]    @relation("BoardCertUpdatedBy")
  malpracticeCreated          MalpracticeInsurance[]  @relation("MalpracticeCreatedBy")
  malpracticeUpdated          MalpracticeInsurance[]  @relation("MalpracticeUpdatedBy")
  educationsCreated           Education[]             @relation("EducationCreatedBy")
  educationsUpdated           Education[]             @relation("EducationUpdatedBy")
  workHistoriesCreated        WorkHistory[]           @relation("WorkHistoryCreatedBy")
  workHistoriesUpdated        WorkHistory[]           @relation("WorkHistoryUpdatedBy")
  workHistoryGapsCreated      WorkHistoryGap[]        @relation("WorkHistoryGapCreatedBy")
  workHistoryGapsUpdated      WorkHistoryGap[]        @relation("WorkHistoryGapUpdatedBy")
  hospitalAffiliationsCreated HospitalAffiliation[]   @relation("HospitalAffiliationCreatedBy")
  hospitalAffiliationsUpdated HospitalAffiliation[]   @relation("HospitalAffiliationUpdatedBy")
  profRefsCreated             ProfessionalReference[] @relation("ProfRefCreatedBy")
  profRefsUpdated             ProfessionalReference[] @relation("ProfRefUpdatedBy")
  coveringColleaguesCreated   CoveringColleague[]     @relation("CoveringColleagueCreatedBy")
  coveringColleaguesUpdated   CoveringColleague[]     @relation("CoveringColleagueUpdatedBy")
  disciplinaryCreated         DisciplinaryAction[]    @relation("DisciplinaryCreatedBy")
  disciplinaryUpdated         DisciplinaryAction[]    @relation("DisciplinaryUpdatedBy")
  contEdCreated               ContinuingEducation[]   @relation("ContEdCreatedBy")
  contEdUpdated               ContinuingEducation[]   @relation("ContEdUpdatedBy")
  supervisingPhysCreated      SupervisingPhysician[]  @relation("SupervisingPhysCreatedBy")
  supervisingPhysUpdated      SupervisingPhysician[]  @relation("SupervisingPhysUpdatedBy")
  malClaimsCreated            MalpracticeClaim[]      @relation("MalClaimCreatedBy")
  malClaimsUpdated            MalpracticeClaim[]      @relation("MalClaimUpdatedBy")
  disclosuresCreated          ProviderDisclosure[]    @relation("DisclosureCreatedBy")
  disclosuresUpdated          ProviderDisclosure[]    @relation("DisclosureUpdatedBy")
  deaRegsCreated              DeaRegistration[]       @relation("DeaRegCreatedBy")
  deaRegsUpdated              DeaRegistration[]       @relation("DeaRegUpdatedBy")
  providerIdsCreated          ProviderIdentifier[]    @relation("ProviderIdCreatedBy")
  providerIdsUpdated          ProviderIdentifier[]    @relation("ProviderIdUpdatedBy")
  bankingCreated              ProviderBanking[]       @relation("BankingCreatedBy")
  bankingUpdated              ProviderBanking[]       @relation("BankingUpdatedBy")
  enrollmentsCreated          Enrollment[]            @relation("EnrollmentCreatedBy")
  enrollmentsUpdated          Enrollment[]            @relation("EnrollmentUpdatedBy")
  emailTemplatesCreated       EmailTemplate[]         @relation("EmailTemplateCreator")
  providerCertsCreated        ProviderCertification[] @relation("ProviderCertCreatedBy")
  providerCertsUpdated        ProviderCertification[] @relation("ProviderCertUpdatedBy")
  cdsRegsCreated              CdsRegistration[]       @relation("CdsRegCreatedBy")
  cdsRegsUpdated              CdsRegistration[]       @relation("CdsRegUpdatedBy")
  webhookSubscriptionsCreated WebhookSubscription[]   @relation("WebhookSubscriptionCreatedBy")

  @@map("users")
}

// ==========================================
// PRACTICE (MULTI-TENANT)
// ==========================================

model Practice {
  id        String         @id @default(uuid())
  name      String
  status    PracticeStatus @default(ACTIVE)
  phone     String?
  email     String?
  website   String?
  notes     String?
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  onboardedAt       DateTime? @map("onboarded_at")
  contractStartDate DateTime? @map("contract_start_date")
  contractEndDate   DateTime? @map("contract_end_date")
  billingEmail      String?   @map("billing_email")
  taxIdEncrypted    String?   @map("tax_id_encrypted") // Encrypted AES-256-GCM
  groupNpi          String?   @map("group_npi")
  setupComplete     Boolean   @default(false) @map("setup_complete")

  // Intake context fields
  accountId         String?  @map("account_id")
  isEnterprise      Boolean  @default(false) @map("is_enterprise")
  locationName      String?  @map("location_name")
  isPrimaryLocation Boolean  @default(true) @map("is_primary_location")
  states            String[] @default([])
  targetPayerIds    String[] @default([]) @map("target_payer_ids")
  providerTypes     String[] @default([]) @map("provider_types")

  // Address
  addressLine1 String? @map("address_line_1")
  addressLine2 String? @map("address_line_2")
  city         String?
  state        String?
  zipCode      String? @map("zip_code")

  organizationType String? @map("organization_type")
  maxProviderSlots Int?    @map("max_provider_slots")
  maxUserSeats     Int?    @map("max_user_seats")

  users                UserPractice[]
  providers            ProviderProfile[]
  providerApplications ProviderApplication[]
  practiceLocations    PracticeLocation[]
  providerImports      ProviderImport[]
  subscription         Subscription?
  practicePayers       PracticePayer[]

  // Phase 1 — submission engine relations
  portalCredentials    PortalCredential[]
  agentWorkflows       AgentWorkflow[]

  // Clinical profile
  organizationTypeId  String?           @map("organization_type_id")
  organizationTypeRef OrganizationType? @relation(fields: [organizationTypeId], references: [id])

  practiceSpecialties        PracticeSpecialty[]
  practiceSubSpecialties     PracticeSubSpecialty[]
  practiceServices           PracticeService[]
  practiceAgeGroups          PracticeAgeGroup[]
  practiceGenderIdentities   PracticeGenderIdentity[]
  practiceSexualOrientations PracticeSexualOrientation[]
  practiceSpecialPopulations PracticeSpecialPopulation[]
  customServices             CustomService[]
  settings                   PracticeSettings?
  enterpriseQueue            EnterpriseQueue[]
  emailLogs                  EmailLog[]
  agentActions               AgentAction[]
  webhookSubscriptions       WebhookSubscription[]
  documents                  Document[]

  @@map("practices")
}

model PracticeSettings {
  id                   String   @id @default(uuid())
  practiceId           String   @unique @map("practice_id")
  practice             Practice @relation(fields: [practiceId], references: [id])
  enrollmentCap        Int?     @map("enrollment_cap") // null = unlimited
  followUpSubmissions  Boolean  @default(true) @map("follow_up_submissions")
  followUpDenialTriage Boolean  @default(true) @map("follow_up_denial_triage")
  multipleLocations    Boolean  @default(false) @map("multiple_locations")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@map("practice_settings")
}

model EnterpriseQueue {
  id         String                @id @default(uuid())
  practiceId String                @map("practice_id")
  practice   Practice              @relation(fields: [practiceId], references: [id])
  status     EnterpriseQueueStatus @default(PENDING)
  notes      String?
  createdAt  DateTime              @default(now()) @map("created_at")
  updatedAt  DateTime              @updatedAt @map("updated_at")

  @@index([practiceId])
  @@map("enterprise_queue")
}

model UserPractice {
  id         String       @id @default(uuid())
  userId     String       @map("user_id")
  practiceId String       @map("practice_id")
  role       PracticeRole
  createdAt  DateTime     @default(now()) @map("created_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  practice Practice @relation(fields: [practiceId], references: [id], onDelete: Cascade)

  @@unique([userId, practiceId])
  @@index([practiceId])
  @@map("user_practices")
}

// ==========================================
// PROVIDER
// ==========================================

enum ProviderStatus {
  active
  inactive
  pending
  pending_verification
}

enum Gender {
  male
  female
  other
  prefer_not_to_say
}

enum ProviderType {
  psychiatrist
  psychologist
  lcsw
  lpc
  lmft
  pmhnp
  other
}

enum CareType {
  in_person
  hybrid
  virtual
  in_home
  other
}

enum CaqhStatus {
  active
  inactive
  pending
  expired
}

// ==========================================
// ENROLLMENT WORKFLOW
// ==========================================

enum WorkflowType {
  medical
  behavioral_health
}

enum WorkflowStepStatus {
  not_started
  in_progress
  completed
  skipped
  blocked
}

enum WorkflowActionType {
  form_submission
  phone_call
  caqh_update
  portal_registration
  document_upload
  waiting_period
  follow_up
  verification
  payer_review
  payer_outreach
  payer_internal
  committee_review
  contract_execution
  contract_delivery
  document_review
  site_visit
  system_processing
  routing_decision
  confirmation
  account_creation
}

enum WorkflowStepOwner {
  provider
  credentialing_staff
  payer
  cvo
}

enum AetnaRunStatus {
  pending
  filling
  awaiting_review
  submitting
  completed
  failed
  rejected
  timed_out
}

model ProviderProfile {
  id String @id @default(uuid())

  // Basic Info
  npi        String  @unique
  firstName  String  @map("first_name")
  lastName   String  @map("last_name")
  middleName String? @map("middle_name")
  suffix     String?
  maidenName String? @map("maiden_name")

  // Personal Info
  dateOfBirth  DateTime @map("date_of_birth")
  gender       Gender
  ssnEncrypted String?  @map("ssn_encrypted") // Encrypted SSN

  // Contact
  email       String
  phone       String
  mobilePhone String? @map("mobile_phone")
  fax         String?

  // Professional
  providerType ProviderType @map("provider_type")
  taxonomy     String?
  specialties  String[]     @default([])
  languages    String[]     @default([])

  // Aetna enrollment automation
  acceptingMedicare Boolean @default(false) @map("accepting_medicare")
  acceptingMedicaid Boolean @default(false) @map("accepting_medicaid")
  ePrescribing      Boolean @default(false) @map("e_prescribing")

  // CAQH Integration
  caqhProviderId             String?     @map("caqh_provider_id")
  caqhStatus                 CaqhStatus? @map("caqh_status")
  caqhLastSync               DateTime?   @map("caqh_last_sync")
  caqhUsername               String?     @map("caqh_username")
  caqhPassword               String?     @map("caqh_password") // Encrypted
  caqhCredentialsValid       Boolean?    @map("caqh_credentials_valid")
  caqhCredentialsLastChecked DateTime?   @map("caqh_credentials_last_checked")

  // CAQH extended fields — populated by CAQH sync
  hospitalBasedFlag             Boolean?  @map("hospital_based_flag")
  hospitalPrivilegeFlag         Boolean?  @map("hospital_privilege_flag")
  fellowshipTrainingFlag        Boolean?  @map("fellowship_training_flag")
  secondarySpecialtyFlag        Boolean?  @map("secondary_specialty_flag")
  activeMilitaryFlag            Boolean?  @map("active_military_flag")
  workHistoryGapFlag            Boolean?  @map("work_history_gap_flag")
  ecfmgFlag                     Boolean?  @map("ecfmg_flag")
  ecfmgNumber                   String?   @map("ecfmg_number")
  ecfmgIssueDate                DateTime? @map("ecfmg_issue_date")
  primaryPracticeState          String?   @map("primary_practice_state")
  otherPracticeState            String?   @map("other_practice_state")
  hospitalAdmittingArrangements Json?     @map("hospital_admitting_arrangements")
  militaryServiceData           Json?     @map("military_service_data")

  // Directory change tracking
  lastDirectoryUpdateAt DateTime? @map("last_directory_update_at")

  // Intake fields
  targetPayers String[]  @default([]) @map("target_payers")
  targetStates String[]  @default([]) @map("target_states")
  entityType   String?   @map("entity_type") // individual | group
  careType     CareType? @map("care_type")

  // Status
  status ProviderStatus @default(pending)

  // Onboarding
  onboardingCompletedAt DateTime? @map("onboarding_completed_at")
  onboardingData        Json?     @map("onboarding_data")

  // Audit
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdById String?  @map("created_by_id")
  updatedById String?  @map("updated_by_id")
  createdBy   User?    @relation("ProviderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy   User?    @relation("ProviderUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  // Multi-tenant
  practiceId String? @map("practice_id")

  // Relations
  user                   User?
  addresses              ProviderAddress[]
  practiceLocations      PracticeLocation[]
  licenses               License[]
  boardCertifications    BoardCertification[]
  malpracticeInsurances  MalpracticeInsurance[]
  educations             Education[]
  workHistories          WorkHistory[]
  workHistoryGaps        WorkHistoryGap[]
  hospitalAffiliations   HospitalAffiliation[]
  professionalReferences ProfessionalReference[]
  disciplinaryActions    DisciplinaryAction[]
  continuingEducations   ContinuingEducation[]
  documents              Document[]
  enrollments            Enrollment[]
  checklist              ProviderChecklist?
  applications           ProviderApplication[]
  tasks                  Task[]
  terminationLetters     TerminationLetter[]
  aiRecommendations      AiRecommendation[]
  supervisingPhysicians  SupervisingPhysician[]
  malpracticeClaims      MalpracticeClaim[]
  disclosures            ProviderDisclosure[]
  coveringColleagues     CoveringColleague[]
  deaRegistrations       DeaRegistration[]
  cdsRegistrations       CdsRegistration[]
  providerCertifications ProviderCertification[]
  providerIdentifiers    ProviderIdentifier[]
  banking                ProviderBanking[]
  demographics           ProviderDemographics?
  caqhMirror             ProviderCaqhMirror?
  agentWorkflows         AgentWorkflow[]
  agentActions           AgentAction[]
  practice               Practice?               @relation(fields: [practiceId], references: [id])
  portalCredentials      PortalCredential[]

  // Clinical profile
  providerSpecialties        ProviderSpecialty[]
  providerSubSpecialties     ProviderSubSpecialty[]
  providerServices           ProviderService[]
  providerAgeGroups          ProviderAgeGroup[]
  providerGenderIdentities   ProviderGenderIdentity[]
  providerSexualOrientations ProviderSexualOrientation[]
  providerSpecialPopulations ProviderSpecialPopulation[]
  customServices             CustomService[]

  @@unique([caqhProviderId], name: "unique_caqh_provider_id")
  @@index([status])
  @@index([practiceId])
  @@index([email])
  @@index([status, practiceId])
  @@map("providers")
}

model ProviderAddress {
  id         String @id @default(uuid())
  providerId String @map("provider_id")

  type         AddressType
  addressLine1 String      @map("address_line_1")
  addressLine2 String?     @map("address_line_2")
  city         String
  state        String
  zipCode      String      @map("zip_code")
  country      String      @default("US")
  isPrimary    Boolean     @default(false) @map("is_primary")

  // Audit
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId])
  @@map("provider_addresses")
}

enum AddressType {
  home
  practice
  mailing
  billing
}

// ==========================================
// PRACTICE LOCATIONS
// ==========================================

model PracticeLocation {
  id         String @id @default(uuid())
  providerId String @map("provider_id")

  // Location Details
  locationName String  @map("location_name")
  locationType String  @map("location_type") // e.g., "office", "telehealth", "hospital"
  isPrimary    Boolean @default(false) @map("is_primary")
  isActive     Boolean @default(true) @map("is_active")

  // Address
  addressLine1 String  @map("address_line_1")
  addressLine2 String? @map("address_line_2")
  city         String
  state        String
  zipCode      String  @map("zip_code")
  county       String?
  country      String  @default("US")

  // Contact
  phone String
  fax   String?
  email String?

  // Business Info
  taxIdEncrypted String? @map("tax_id_encrypted") // Encrypted AES-256-GCM
  npi            String? // Location-specific NPI if different from provider
  groupNpi       String? @map("group_npi")

  // Hours (JSON object with day: {open, close} format)
  officeHours Json? @map("office_hours")

  // Accessibility
  wheelchairAccessible Boolean @default(false) @map("wheelchair_accessible")
  publicTransitAccess  Boolean @default(false) @map("public_transit_access")
  parkingAvailable     Boolean @default(true) @map("parking_available")

  // Additional Info
  acceptingNewPatients Boolean  @default(true) @map("accepting_new_patients")
  languagesSpoken      String[] @default([]) @map("languages_spoken")
  specialServices      String[] @default([]) @map("special_services")
  notes                String?

  // CAQH extended fields
  interpreterAvailable  Boolean?         @map("interpreter_available")
  currentlyPracticing   Boolean?         @map("currently_practicing")
  hasPracticeLimitation Boolean?         @map("has_practice_limitation")
  practiceSpecialty     String?          @map("practice_specialty")
  source                CredentialSource @default(manual_entry)

  // Billing address (if different from service address)
  billingAddressLine1 String? @map("billing_address_line_1")
  billingAddressLine2 String? @map("billing_address_line_2")
  billingCity         String? @map("billing_city")
  billingState        String? @map("billing_state")
  billingZipCode      String? @map("billing_zip_code")
  medicarePOS         String? @map("medicare_pos") // Place of Service code

  // Directory change tracking
  lastDirectoryUpdateAt DateTime? @map("last_directory_update_at")

  // Audit
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdById String?  @map("created_by_id")
  updatedById String?  @map("updated_by_id")
  createdBy   User?    @relation("PracticeLocationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy   User?    @relation("PracticeLocationUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  // Multi-tenant
  practiceId String? @map("practice_id")

  // Relations
  provider              ProviderProfile             @relation(fields: [providerId], references: [id], onDelete: Cascade)
  practice              Practice?                   @relation(fields: [practiceId], references: [id])
  malpracticePolicies   MalpracticePolicyLocation[]
  supervisingPhysicians SupervisingPhysician[]

  @@map("practice_locations")
}

// ==========================================
// CREDENTIALS
// ==========================================

enum CredentialStatus {
  active
  expired
  pending
  revoked
}

enum CredentialSource {
  manual_entry
  caqh_sync
  portal_import
  agent_parsed
}

enum LicenseType {
  state_medical
  state_psychology
  state_social_work
  state_counseling
  state_marriage_family
  dea
  controlled_substance
  npi
}

model License {
  id         String @id @default(uuid())
  providerId String @map("provider_id")

  licenseType        LicenseType      @map("license_type")
  licenseNumber      String           @map("license_number")
  state              String?
  issueDate          DateTime?        @map("issue_date") // Made optional — CAQH may not return
  expirationDate     DateTime         @map("expiration_date")
  status             CredentialStatus @default(active)
  verificationDate   DateTime?        @map("verification_date")
  verificationSource String?          @map("verification_source")
  caqhLicenseId      String?          @map("caqh_license_id") // Stable CAQH ID for dedupe
  isPrimary          Boolean?         @map("is_primary")
  currentlyPracticing Boolean?        @map("currently_practicing")
  notes              String?
  source             CredentialSource @default(manual_entry)

  // Audit
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdById String?  @map("created_by_id")
  updatedById String?  @map("updated_by_id")
  createdBy   User?    @relation("LicenseCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy   User?    @relation("LicenseUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  // Relations
  provider  ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  documents Document[]

  @@index([providerId])
  @@index([expirationDate])
  @@map("licenses")
}

enum BoardType {
  abpn_psychiatry
  abpn_child_adolescent
  abpn_addiction
  abpp_clinical
  abpp_counseling
  abecsw
  nbcc
  aamft
  ancc_pmhnp
  other
}

model BoardCertification {
  id         String @id @default(uuid())
  providerId String @map("provider_id")

  boardType                BoardType        @map("board_type")
  boardName                String           @map("board_name")
  certificationNumber      String?          @map("certification_number")
  specialty                String
  initialCertificationDate DateTime?        @map("initial_certification_date") // Optional — CAQH may not return
  expirationDate           DateTime?        @map("expiration_date")
  status                   CredentialStatus @default(active)
  isBoardEligible          Boolean          @default(false) @map("is_board_eligible")
  isBoardCertified         Boolean?         @map("is_board_certified")
  nuccTaxonomyCode         String?          @map("nucc_taxonomy_code")
  caqhSpecialtyId          String?          @map("caqh_specialty_id")
  notes                    String?
  source                   CredentialSource @default(manual_entry)

  // Audit
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdById String?  @map("created_by_id")
  updatedById String?  @map("updated_by_id")
  createdBy   User?    @relation("BoardCertCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy   User?    @relation("BoardCertUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  // Relations
  provider  ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  documents Document[]

  @@index([providerId])
  @@index([expirationDate])
  @@map("board_certifications")
}

enum CoverageType {
  occurrence
  claims_made
}

model MalpracticePolicyLocation {
  id                     String @id @default(uuid())
  malpracticeInsuranceId String @map("malpractice_insurance_id")
  practiceLocationId     String @map("practice_location_id")

  caqhRawLabel String? @map("caqh_raw_label")
  matchedVia   String? @map("matched_via")

  createdAt DateTime @default(now()) @map("created_at")

  malpracticeInsurance MalpracticeInsurance @relation(fields: [malpracticeInsuranceId], references: [id], onDelete: Cascade)
  practiceLocation     PracticeLocation     @relation(fields: [practiceLocationId], references: [id], onDelete: Cascade)

  @@unique([malpracticeInsuranceId, practiceLocationId])
  @@index([practiceLocationId])
  @@map("malpractice_policy_locations")
}

model MalpracticeInsurance {
  id         String @id @default(uuid())
  providerId String @map("provider_id")

  carrierName     String           @map("carrier_name")
  policyNumber    String           @map("policy_number")
  coverageType    CoverageType     @map("coverage_type")
  perClaimAmount  Decimal          @map("per_claim_amount") @db.Decimal(15, 2)
  aggregateAmount Decimal          @map("aggregate_amount") @db.Decimal(15, 2)
  effectiveDate   DateTime         @map("effective_date")
  expirationDate  DateTime         @map("expiration_date")
  hasTailCoverage Boolean          @default(false) @map("has_tail_coverage")
