  patientAgeGroupId String   @map("patient_age_group_id")
  createdAt         DateTime @default(now()) @map("created_at")

  provider        ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  patientAgeGroup PatientAgeGroup @relation(fields: [patientAgeGroupId], references: [id], onDelete: Cascade)

  @@unique([providerId, patientAgeGroupId])
