# Backend package gitignore — belt-and-suspenders alongside repo-root .gitignore.
# A previous orphaned nested .git in this directory committed .env and dist/
# (LOCAL ONLY, never pushed). The nested repo has been deleted; this file
# prevents recurrence if anyone re-initializes a git repo here.

# Environment files — never commit secrets
.env
.env.*
!.env.example

# Build output — regenerated by tsc; large, churn-heavy, not source
dist/

# Dependencies — installed via npm workspaces from repo root
node_modules/

# Editor / OS noise
.DS_Store
*.log
.vitest-cache/
