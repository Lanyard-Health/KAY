{
  "components": {
    "parameters": {},
    "schemas": {
      "CreateWebhookSubscriptionRequest": {
        "properties": {
          "description": {
            "maxLength": 500,
            "type": "string"
          },
          "eventTypes": {
            "items": {
              "enum": [
                "agent_event.created",
                "enrollment.status_changed",
                "credential.expired"
              ],
              "type": "string"
            },
            "maxItems": 3,
            "minItems": 1,
            "type": "array"
          },
          "practiceId": {
            "format": "uuid",
            "type": "string"
          },
          "url": {
            "format": "uri",
            "maxLength": 2048,
            "type": "string"
          }
        },
        "required": [
          "practiceId",
          "url",
          "eventTypes"
        ],
        "type": "object"
      },
      "ErrorEnvelope": {
        "properties": {
          "error": {
            "properties": {
              "details": {},
              "message": {
                "type": "string"
              }
            },
            "required": [
              "message"
            ],
            "type": "object"
          },
          "success": {
            "enum": [
              false
            ],
            "type": "boolean"
          }
        },
        "required": [
          "success",
          "error"
        ],
        "type": "object"
      },
      "SigningKeyset": {
        "properties": {
          "keys": {
            "items": {
              "properties": {
                "keyId": {
                  "type": "string"
                },
                "publicKey": {
                  "description": "PEM-encoded Ed25519 public key",
                  "type": "string"
                },
                "retiredAt": {
                  "format": "date-time",
                  "type": "string"
                },
                "status": {
                  "enum": [
                    "current",
                    "retired"
                  ],
                  "type": "string"
                }
              },
              "required": [
                "keyId",
                "publicKey",
                "status"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "keys"
        ],
        "type": "object"
      },
      "WebhookSubscriptionPublic": {
        "properties": {
          "active": {
            "type": "boolean"
          },
          "consecutiveFailures": {
            "type": "integer"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "deletedAt": {
            "format": "date-time",
            "type": [
              "string",
              "null"
            ]
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "eventTypes": {
            "items": {
              "enum": [
                "agent_event.created",
                "enrollment.status_changed",
                "credential.expired"
              ],
              "type": "string"
            },
            "type": "array"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "lastDeliveryAt": {
            "format": "date-time",
            "type": [
              "string",
              "null"
            ]
          },
          "lastFailureAt": {
            "format": "date-time",
            "type": [
              "string",
              "null"
            ]
          },
          "practiceId": {
            "format": "uuid",
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          },
          "url": {
            "format": "uri",
            "type": "string"
          }
        },
        "required": [
          "id",
          "practiceId",
          "url",
          "eventTypes",
          "description",
          "active",
          "createdAt",
          "updatedAt",
          "deletedAt",
          "lastDeliveryAt",
          "lastFailureAt",
          "consecutiveFailures"
        ],
        "type": "object"
      },
      "WebhookSubscriptionWithSecret": {
        "allOf": [
          {
            "$ref": "#/components/schemas/WebhookSubscriptionPublic"
          },
          {
            "properties": {
              "secret": {
                "description": "Plain-text HMAC-SHA256 signing secret. Returned exactly once at create time. Lost-secret recovery requires re-creating the subscription.",
                "type": "string"
              }
            },
            "required": [
              "secret"
            ],
            "type": "object"
          }
        ]
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "bearerFormat": "JWT",
        "description": "AWS Cognito-issued JWT bearer token",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "OpenAPI 3.1 spec for the Lanyard Health backend. Phase 0.A scope: webhook subscription API and the .well-known signing-key endpoints shipped in PRs 1 and 4, plus the public portal registration endpoints (CAQH-first onboarding). The remaining existing routes will be annotated in Phase 0.B per the platform foundations plan.",
    "title": "Lanyard Health API",
    "version": "0.1.0-phase-0a"
  },
  "openapi": "3.1.0",
  "paths": {
    "/.well-known/lanyard-signing-key.pem": {
      "get": {
        "description": "Current Ed25519 public key used to sign AgentEvent rows. Consumed by simple verifiers that prefer raw PEM over JSON. No authentication.",
        "responses": {
          "200": {
            "content": {
              "application/x-pem-file": {
                "schema": {
                  "example": "-----BEGIN PUBLIC KEY-----\nMCowBQYDK2VwAyEA...\n-----END PUBLIC KEY-----\n",
                  "type": "string"
                }
              }
            },
            "description": "PEM-encoded public key."
          },
          "503": {
            "description": "Signing key not configured on this environment."
          }
        },
        "summary": "Current signing public key (PEM)",
        "tags": [
          "Well-Known"
        ]
      }
    },
    "/.well-known/lanyard-signing-keys.json": {
      "get": {
        "description": "JWKS-style keyset listing the current signing key and all retired keys. External verifiers reference the signatureKeyId on each AgentEvent against the keyId fields here to verify historical signatures after rotation. No authentication.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SigningKeyset"
                }
              }
            },
            "description": "Keyset with at minimum the current key. Empty when unconfigured."
          }
        },
        "summary": "Full signing keyset (current + retired)",
        "tags": [
          "Well-Known"
        ]
      }
    },
    "/api/v1/portal/register": {
      "post": {
        "description": "Public, rate-limited. Creates a pending ProviderApplication for admin review. caqhProviderId is optional; when provided it is validated for uniqueness against existing providers and pending applications, and is copied to the provider profile on approval (enables automatic CAQH profile/document import).",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "caqhProviderId": {
                    "anyOf": [
                      {
                        "pattern": "^\\d{6,12}$",
                        "type": "string"
                      },
                      {
                        "enum": [
                          ""
                        ],
                        "type": "string"
                      }
                    ]
                  },
                  "dateOfBirth": {
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                    "type": "string"
                  },
                  "email": {
                    "format": "email",
                    "type": "string"
                  },
                  "firstName": {
                    "maxLength": 100,
                    "minLength": 2,
                    "type": "string"
                  },
                  "gender": {
                    "enum": [
                      "male",
                      "female",
                      "other",
                      "prefer_not_to_say"
                    ],
                    "type": "string"
                  },
                  "lastName": {
                    "maxLength": 100,
                    "minLength": 2,
                    "type": "string"
                  },
                  "middleName": {
                    "maxLength": 100,
                    "type": "string"
                  },
                  "npi": {
                    "pattern": "^\\d{10}$",
                    "type": "string"
                  },
                  "phone": {
                    "pattern": "^\\+?1?[-.\\s]?\\(?\\d{3}\\)?[-.\\s]?\\d{3}[-.\\s]?\\d{4}$",
                    "type": "string"
                  },
                  "practiceId": {
                    "format": "uuid",
                    "type": "string"
                  },
                  "providerType": {
                    "enum": [
                      "psychiatrist",
                      "psychologist",
                      "lcsw",
                      "lpc",
                      "lmft",
                      "pmhnp",
                      "other"
                    ],
                    "type": "string"
                  },
                  "specialties": {
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  },
                  "suffix": {
                    "maxLength": 20,
                    "type": "string"
                  },
                  "taxonomy": {
                    "maxLength": 50,
                    "type": "string"
                  }
                },
                "required": [
                  "npi",
                  "firstName",
                  "lastName",
                  "email",
                  "phone",
                  "dateOfBirth",
                  "gender"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "data": {
                      "properties": {
                        "id": {
                          "format": "uuid",
                          "type": "string"
                        },
                        "status": {
                          "type": "string"
                        },
                        "submittedAt": {
                          "format": "date-time",
                          "type": "string"
                        }
                      },
                      "required": [
                        "id",
                        "status",
                        "submittedAt"
                      ],
                      "type": "object"
                    },
                    "message": {
                      "type": "string"
                    },
                    "success": {
                      "enum": [
                        true
                      ],
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "success",
                    "message",
                    "data"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Application submitted and queued for review."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Validation failure or unknown/inactive practice link."
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Duplicate NPI, email, or CAQH Provider ID (existing provider or pending application)."
          },
          "429": {
            "description": "Rate limit exceeded."
          }
        },
        "summary": "Submit a provider application",
        "tags": [
          "Portal"
        ]
      }
    },
    "/api/v1/portal/self-serve-signup": {
      "post": {
        "description": "Public, rate-limited. Creates a Cognito user, ProviderProfile (pending_verification), User, and a pending ProviderApplication in one step. Same caqhProviderId semantics as /portal/register, except the ID lands on the provider profile immediately.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "caqhProviderId": {
                    "anyOf": [
                      {
                        "pattern": "^\\d{6,12}$",
                        "type": "string"
                      },
                      {
                        "enum": [
                          ""
                        ],
                        "type": "string"
                      }
                    ]
                  },
                  "confirmPassword": {
                    "type": "string"
                  },
                  "dateOfBirth": {
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                    "type": "string"
                  },
                  "email": {
                    "format": "email",
                    "type": "string"
                  },
                  "firstName": {
                    "maxLength": 100,
                    "minLength": 2,
                    "type": "string"
                  },
                  "gender": {
                    "enum": [
                      "male",
                      "female",
                      "other",
                      "prefer_not_to_say"
                    ],
                    "type": "string"
                  },
                  "lastName": {
                    "maxLength": 100,
                    "minLength": 2,
                    "type": "string"
                  },
                  "middleName": {
                    "maxLength": 100,
                    "type": "string"
                  },
                  "npi": {
                    "pattern": "^\\d{10}$",
                    "type": "string"
                  },
                  "password": {
                    "minLength": 12,
                    "pattern": "[A-Z]",
                    "type": "string"
                  },
                  "phone": {
                    "pattern": "^\\+?1?[-.\\s]?\\(?\\d{3}\\)?[-.\\s]?\\d{3}[-.\\s]?\\d{4}$",
                    "type": "string"
                  },
                  "practiceId": {
                    "format": "uuid",
                    "type": "string"
                  },
                  "providerType": {
                    "enum": [
                      "psychiatrist",
                      "psychologist",
                      "lcsw",
                      "lpc",
                      "lmft",
                      "pmhnp",
                      "other"
                    ],
                    "type": "string"
                  },
                  "specialties": {
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  },
                  "suffix": {
                    "maxLength": 20,
                    "type": "string"
                  },
                  "taxonomy": {
                    "maxLength": 50,
                    "type": "string"
                  }
                },
                "required": [
                  "npi",
                  "firstName",
                  "lastName",
                  "email",
                  "phone",
                  "dateOfBirth",
                  "gender",
                  "password",
                  "confirmPassword"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "data": {
                      "properties": {
                        "email": {
                          "format": "email",
                          "type": "string"
                        },
                        "providerId": {
                          "format": "uuid",
                          "type": "string"
                        },
                        "userId": {
                          "format": "uuid",
                          "type": "string"
                        }
                      },
                      "required": [
                        "userId",
                        "providerId",
                        "email"
                      ],
                      "type": "object"
                    },
                    "message": {
                      "type": "string"
                    },
                    "success": {
                      "enum": [
                        true
                      ],
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "success",
                    "message",
                    "data"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Account created; provider has instant portal access pending verification."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Validation failure."
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Duplicate NPI, email, or CAQH Provider ID."
          },
          "429": {
            "description": "Rate limit exceeded."
          }
        },
        "summary": "Self-serve provider signup (instant access)",
        "tags": [
          "Portal"
        ]
      }
    },
    "/api/v1/webhook-subscriptions": {
      "get": {
        "description": "Returns active and paused subscriptions in the caller's practice scope. Soft-deleted rows are excluded. The HMAC secret is never returned.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "data": {
                      "items": {
                        "$ref": "#/components/schemas/WebhookSubscriptionPublic"
                      },
                      "type": "array"
                    },
                    "success": {
                      "enum": [
                        true
                      ],
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "success",
                    "data"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Subscriptions list (HMAC secret excluded)."
          },
          "401": {
            "description": "Unauthenticated."
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "List webhook subscriptions",
        "tags": [
          "Webhooks"
        ]
      },
      "post": {
        "description": "Register a destination URL to receive outbound webhook deliveries. Returns the HMAC-SHA256 signing secret exactly once in the response body — it is never returned by GET. Subscription is rejected if the URL resolves to a private/loopback/link-local IP address (SSRF guard). HTTPS is required in production.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateWebhookSubscriptionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/WebhookSubscriptionWithSecret"
                    },
                    "success": {
                      "enum": [
                        true
                      ],
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "success",
                    "data"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Subscription created. Includes the plain-text HMAC secret (one-time)."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Invalid request body, non-HTTPS URL in production, or SSRF guard rejection."
          },
          "401": {
            "description": "Unauthenticated."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Caller is not a member of the requested practice."
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Create a webhook subscription",
        "tags": [
          "Webhooks"
        ]
      }
    },
    "/api/v1/webhook-subscriptions/{id}": {
      "delete": {
        "description": "Marks the subscription deleted and disables future deliveries. Returns 404 if the subscription does not exist, is already deleted, or belongs to a practice the caller cannot access (no existence leak across practices).",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "description": "Subscription id",
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/WebhookSubscriptionPublic"
                    },
                    "success": {
                      "enum": [
                        true
                      ],
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "success",
                    "data"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Subscription soft-deleted."
          },
          "401": {
            "description": "Unauthenticated."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Subscription not found, already deleted, or out of practice scope."
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Soft-delete a webhook subscription",
        "tags": [
          "Webhooks"
        ]
      }
    }
  },
  "servers": [
    {
      "description": "Production",
      "url": "https://kay-os62.onrender.com"
    },
    {
      "description": "Local development",
      "url": "http://localhost:3002"
    }
  ],
  "webhooks": {}
}
